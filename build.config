config:
  namespace: fg-prod
  branch: main
  maintainers:
    - ops@fineguide.ai

services:
  website:
    domain: fineguide.ai
    type: docker_service
    enabled: true
    priority_class: user-facing   # evicted last when hnz-01 runs short of disk (2026-11-19 evictions)
    ephemeral_storage: 1Gi
    url_prefix: /
    port: 80
    # A static site: no sticky sessions, so Traefik sets no cookie and Cloudflare can cache what it serves.
    sticky: false
