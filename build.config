config:
  namespace: fg-prod
  branch: main
  maintainers:
    - ops@fineguide.ai

services:
  website:
    domain: fineguide.ai
    type: docker_service
    enabled: true
    url_prefix: /
    port: 80
    # A static site: no sticky sessions, so Traefik sets no cookie and Cloudflare can cache what it serves.
    sticky: false
