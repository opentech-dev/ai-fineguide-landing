config:
  namespace: fg-prod
  branch: main
  maintainers:
    - ops@fineguide.ai

services:
  website:
    domain: fineguide.ai
    type: docker_service
    enabled: true
    priority_class: user-facing   # evicted last when hnz-01 runs short of disk (2026-11-19 evictions)
    ephemeral_storage: 1Gi
    url_prefix: /
    port: 80
    # A static site: no sticky sessions, so Traefik sets no cookie and Cloudflare can cache what it serves.
    sticky: false
    # The website's HTML is cached at Cloudflare's edge (a Cache Rule on host fineguide.ai, never /api/); each new pod
    # empties that cache when it takes over (docker/start.sh). cf-purge holds CF_PURGE_TOKEN, a token that can only
    # purge this zone's cache; made by hand on the cluster with `kubectl create secret generic cf-purge` (2026-11-25).
    inherit_shared_secrets: false
    shared_secrets:
    - cf-purge
    env:
      CF_ZONE_ID: 9577bc9e3bff8724a1f2832d6a878544
