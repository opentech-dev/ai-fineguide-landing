---
import '../styles/global.css';
import { LANGS, RO_LOCALE_MIRRORS_ENGLISH, getLocalizedPath, switchLangPath, type Lang } from '../i18n/utils';
import CookieConsent from '../components/CookieConsent.astro';
import { founderRef } from '../data/people';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Absolute-from-root path to the social card. Defaults to the brand card. */
  ogImage?: string;
  /** Extra JSON-LD for this page (SoftwareApplication, FAQPage, …). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep a page out of the index (none currently need it, but thank-you
      pages and the like will). */
  noindex?: boolean;
  /** A blog post: og:type article with its dates and tags. The API checks the
      live page for `article:modified_time` to know a publish has landed. */
  article?: { publishedTime: string; modifiedTime: string; section?: string; tags?: string[]; author?: string };
  /** The page's own language when it is not the site's (a post in Russian). */
  contentLang?: string;
  /** Every site page has an English, Romanian and Russian copy and names all three; the blog, in one language,
      leaves the cluster out. A page whose copies sit at other paths names them, [lang, path] each, English among them. */
  hreflang?: boolean | Array<[lang: string, path: string]>;
  /** The breadcrumb under Home, when the page is deeper than one level. */
  breadcrumb?: Array<[path: string, label: string]>;
  /** Extra <link rel="alternate"> (the blog's feed, a post's Markdown copy). */
  alternates?: Array<{ type: string; href: string; title: string }>;
  /** Extra stylesheets this page alone needs (the blog's fonts). */
  stylesheets?: string[];
  /** The Fineguide chat: 'auto' loads it with the page (its greeting bubble included); 'on-demand' shows a quiet
      launcher and loads the chat only when the reader asks for it — the blog, where the bubble sat over the text. */
  chat?: 'auto' | 'on-demand';
}

const {
  title,
  description,
  lang = 'en',
  ogImage = '/images/og-default.png',
  jsonLd,
  noindex = false,
  article,
  contentLang,
  hreflang = true,
  breadcrumb,
  alternates = [],
  stylesheets = [],
  chat = 'auto',
} = Astro.props;
const CHATBOT_ID = 'b5b3f5f1-7d78-4bd2-93cd-3f3a8e6cde47';

const SITE = 'https://fineguide.ai';
const htmlLang = contentLang ?? (lang === 'ro' && RO_LOCALE_MIRRORS_ENGLISH ? 'en' : lang);
const OG_LOCALES: Record<string, string> = { en: 'en_US', ro: 'ro_RO', ru: 'ru_RU' };
const ogLocale = OG_LOCALES[htmlLang] ?? 'en_US';

// Astro writes every route as `<path>/index.html`, so the served URL always has
// a trailing slash. Canonical must match that exactly or it points at a URL that
// redirects, which is worse than emitting nothing.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, SITE).href;
const ogUrl = canonical;
const ogImageUrl = /^https?:\/\//.test(ogImage) ? ogImage : new URL(ogImage, SITE).href;

// Each page declares its own translation. x-default points at English: it is the
// fallback for a reader whose language we do not publish.
// switchLangPath returns "/ro" for the Romanian root, with no trailing slash,
// while the canonical of that same page is "/ro/". An hreflang cluster that
// names a different URL than the canonical is self-contradictory, so normalise
// both alternates the same way the canonical is normalised.
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const langHref = (l: Lang) => new URL(withSlash(switchLangPath(path, l)), SITE).href;

const hreflangCluster: Array<[string, string]> = Array.isArray(hreflang)
  ? [
      ...hreflang.map(([l, p]): [string, string] => [l, new URL(p, SITE).href]),
      ['x-default', new URL(hreflang.find(([l]) => l === 'en')![1], SITE).href],
    ]
  : hreflang
    ? [...LANGS.map((l): [string, string] => [l, langHref(l)]), ['x-default', langHref('en')]]
    : [];

const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Site-wide identity. Emitted once per page so any page can be the one a
// crawler happens to land on first; other blocks point at it by its @id. The
// facts are the ones the About page shows (src/pages/about.astro): the founder
// as the owner states it, the city, the public contact. No hosting or vendors.
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#org`,
  name: 'Fineguide.AI',
  alternateName: ['Fineguide', 'FineGuide', 'fineguide.ai'],
  url: `${SITE}/`,
  logo: { '@type': 'ImageObject', url: `${SITE}/images/fineguide-mark-512.png`, width: 512, height: 512 },
  description:
    'Fineguide.AI is an AI-first CRM and business-automation platform: AI assistants on the website and messaging apps, a CRM, a shared inbox with email, AI phone calls and outbound call campaigns, and call-quality scoring.',
  founder: founderRef,
  // The same entity elsewhere: Fineguide's Wikidata item (created 2026-10-22, every statement referenced to this site).
  sameAs: ['https://www.wikidata.org/wiki/Q141808770'],
  address: { '@type': 'PostalAddress', addressLocality: 'Chișinău', addressCountry: 'MD' },
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer support', email: 'contact@fineguide.ai', telephone: '+373-60-419-281', availableLanguage: ['en', 'ro'] },
  ],
};

// The site is flat - every page is one level under the locale root - so a
// breadcrumb is fully derivable and no page has to hand-write one. The leaf
// label is the title up to the first separator, which is how these titles are
// already written ("CRM | … | Fineguide.ai").
const isHome = path === '/' || path === '/ro/' || path === '/ru/';
// The site itself, on its home pages (where Google looks for it).
const websiteLd = isHome
  ? { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Fineguide.AI', inLanguage: lang, publisher: { '@id': `${SITE}/#org` } }
  : null;
const askLabel = { en: 'Ask Fineguide', ro: 'Întreabă Fineguide', ru: 'Спросить Fineguide' }[htmlLang] ?? 'Ask Fineguide';
// The standard share card is 1200 × 630; any other image (a post's cover) says nothing it cannot back up.
const defaultCard = ogImage === '/images/og-default.png';
const leafLabel = title.split('|')[0].trim();
const trail: Array<[string, string]> = breadcrumb ?? [[path, leafLabel]];
const breadcrumbLd = isHome
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL(getLocalizedPath('/', lang), SITE).href,
        },
        ...trail.map(([p, name], i) => ({ '@type': 'ListItem', position: i + 2, name, item: new URL(p, SITE).href })),
      ],
    };
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Fineguide.ai" />
    {/* A page kept out of the index still passes its links on (a thin tag page links real posts). */}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <link rel="canonical" href={canonical} />
    {hreflangCluster.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
    {alternates.map((a) => <link rel="alternate" type={a.type} href={a.href} title={a.title} />)}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Fineguide.ai" />
    <meta property="og:image" content={ogImageUrl} />
    {defaultCard && <meta property="og:image:width" content="1200" />}
    {defaultCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationLd)}
    />
    {websiteLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />}
    {
      breadcrumbLd && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
      )
    }
    {
      ldBlocks.map((block) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
      ))
    }

    <meta name="theme-color" content="#f7f8fa" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* The site's fonts as a stylesheet link, not a CSS @import (which the browser only finds after the CSS loads) */}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" />
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}

    <!-- Fineguide AI Chatbot -->
    {chat === 'auto' && <script is:inline define:vars={{ id: CHATBOT_ID }}>window.FINEGUIDE_CHATBOT_ID = id;</script>}
    {chat === 'auto' && <script is:inline defer src="https://cdn.fineguide.ai/fineguide.min.js"></script>}

<!-- Google Ads and the Meta Pixel load from CookieConsent, only after the visitor accepts. -->

  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--color-primary)] focus:text-white focus:text-sm focus:font-semibold">
      {{ en: 'Skip to content', ro: 'Sari la conținut', ru: 'Перейти к содержанию' }[htmlLang] ?? 'Skip to content'}
    </a>
    <slot />

    <CookieConsent lang={lang} />

    {chat === 'on-demand' && (
      <button type="button" id="fg-ask" class="fg-ask" aria-label={askLabel}>
        <svg viewBox="0 0 2180 2171" aria-hidden="true"><path d="M980.811 44.4505C1040.2 -14.8097 1136.37 -14.8179 1195.76 44.4323L1270.64 119.128L1453 301.054L1261.04 492.631L1088.28 320.267L320.646 1086.3L608.532 1373.57L992.347 990.514L1184.3 1182.09L800.391 1565.06L973.159 1737.42L781.208 1929L44.6354 1193.9C-14.8797 1134.5 -14.8782 1038.1 44.6384 978.71L980.811 44.4505Z" fill="#fff" /><path d="M1106.87 873.625L1299.56 1065.2L1569.3 797.054L1858.3 1084.32L895 2041.9L980.357 2126.76C1039.69 2185.74 1135.53 2185.74 1194.86 2126.77L2135.15 1192.12C2194.95 1132.68 2194.95 1035.96 2135.15 976.509L1569.3 414L1106.87 873.625Z" fill="#c4b5fd" /></svg>
        <span>{askLabel}</span>
      </button>
      <style is:inline>
        .fg-ask { position: fixed; right: 20px; bottom: 20px; z-index: 2147483000; display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px 10px 12px; border: 1px solid rgba(196, 181, 253, 0.35); border-radius: 999px; background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #fff; font: 600 14px/1 Inter, system-ui, sans-serif; box-shadow: 0 12px 30px -10px rgba(76, 29, 149, 0.7); cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .fg-ask:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -10px rgba(76, 29, 149, 0.85); }
        .fg-ask svg { width: 22px; height: 22px; flex: none; }
        .fg-ask[aria-busy='true'] { opacity: 0.75; cursor: progress; }
        @media (max-width: 639px) { .fg-ask { right: 14px; bottom: 14px; padding: 12px; } .fg-ask span { display: none; } }
        @media (prefers-reduced-motion: reduce) { .fg-ask { transition: none; } }
      </style>
      <script is:inline define:vars={{ id: CHATBOT_ID }}>
        (function () {
          var btn = document.getElementById('fg-ask');
          if (!btn) return;
          // The chat loads on the first click, then opens itself; the launcher steps aside for the chat's own button.
          btn.addEventListener('click', function () {
            if (btn.getAttribute('aria-busy') === 'true') return;
            btn.setAttribute('aria-busy', 'true');
            window.FINEGUIDE_CHATBOT_ID = id;
            var s = document.createElement('script');
            s.src = 'https://cdn.fineguide.ai/fineguide.min.js';
            s.async = true;
            s.onerror = function () { btn.removeAttribute('aria-busy'); };
            document.head.appendChild(s);
            var tries = 0;
            (function open() {
              if (typeof window.$__fg_window_open === 'function') { window.$__fg_window_open(); btn.remove(); return; }
              if (++tries < 100) setTimeout(open, 100); else btn.removeAttribute('aria-busy');
            })();
          });
        })();
      </script>
    )}

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } }),
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    {/* No client-side language redirect: Google renders pages with an English browser, so a script that sends
        anyone off /ro/ hid the whole Romanian site from search. Apache sends a first visit to "/" to /ru/ when the
        browser's first language is Russian, else to /ro/ from Moldova or Romania (apache/fineguide.conf); the
        footer's language switch is a plain link. */}

  </body>
</html>
