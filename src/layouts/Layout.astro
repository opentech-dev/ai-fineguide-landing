---
import '../styles/global.css';
import { RO_LOCALE_MIRRORS_ENGLISH, type Lang } from '../i18n/utils';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;

const htmlLang = lang === 'ro' && RO_LOCALE_MIRRORS_ENGLISH ? 'en' : lang;
const ogLocale =
  lang === 'ro' && RO_LOCALE_MIRRORS_ENGLISH ? 'en_US' : lang === 'ro' ? 'ro_RO' : 'en_US';
const ogUrl = new URL(Astro.url.pathname, 'https://fineguide.ai').href;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Fineguide.ai" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Fineguide.ai" />

    <meta name="theme-color" content="#f7f8fa" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href="/images/hero-bg.jpg" />

    <!-- Fineguide AI Chatbot -->
    <script is:inline>var FINEGUIDE_CHATBOT_ID = 'b5b3f5f1-7d78-4bd2-93cd-3f3a8e6cde47';</script>
    <script is:inline src="https://cdn.fineguide.ai/fineguide.min.js"></script>

<!-- Google Ads and the Meta Pixel load from CookieConsent, only after the visitor accepts. -->

  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--color-primary)] focus:text-white focus:text-sm focus:font-semibold">
      {htmlLang === 'en' ? 'Skip to content' : 'Sari la conținut'}
    </a>
    <slot />

    <CookieConsent lang={lang} />

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } }),
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <script is:inline>
      (function() {
        function setLangPref(lang) {
          localStorage.setItem('fg-lang', lang);
          document.cookie = 'fg-lang=' + lang + ';path=/;max-age=31536000;SameSite=Lax';
        }

        var pref = localStorage.getItem('fg-lang');
        if (pref) {
          if (document.cookie.indexOf('fg-lang=') === -1) setLangPref(pref);
          return;
        }

        var path = window.location.pathname;
        var isRo = path.startsWith('/ro');
        var langs = navigator.languages || [navigator.language || ''];
        var wantsRo = langs.some(function(l) { return l.startsWith('ro'); });

        if (wantsRo && !isRo) {
          setLangPref('ro');
          window.location.replace('/ro' + (path === '/' ? '' : path));
        } else if (!wantsRo && isRo) {
          var enPath = path.replace(/^\/ro/, '') || '/';
          setLangPref('en');
          window.location.replace(enPath);
        } else {
          setLangPref(isRo ? 'ro' : 'en');
        }
      })();
    </script>

  </body>
</html>
