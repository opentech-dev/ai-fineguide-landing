---
/**
 * Numbered steps. Numbers here mean order: use this only where the items happen
 * one after another. Parallel options belong in EditorialRows or RuleList.
 */
interface Props {
  steps: readonly string[];
}

const { steps } = Astro.props as Props;
---

<ol class="border-b border-[var(--color-border)]">
  {
    steps.map((step, i) => (
      <li class="flex gap-6 border-t border-[var(--color-border)] py-6">
        <span class="font-[var(--font-display)] text-2xl md:text-3xl font-semibold text-[var(--color-primary)] tabular-nums shrink-0 w-10">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="text-lg md:text-xl text-[var(--color-foreground)] leading-relaxed">{step}</span>
      </li>
    ))
  }
</ol>
