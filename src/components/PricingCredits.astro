---
import Band from './Band.astro';
import EditorialRows from './EditorialRows.astro';
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };

// The rules behind the rates, one row each. This used to be three boxed
// tables, one of which charged 2 credits for an attachment. Nothing does: the
// real extra cost of a reply is the number of actions the assistant takes.
const c = t.pricingCredits;
---

<Band eyebrow={c.eyebrow} heading={c.heading}>
  <EditorialRows items={c.items} />
</Band>
