---
import type { Translations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const { t, lang } = Astro.props as { t: Translations; lang: Lang };
---

<section class="band-tint py-16 md:py-20 px-6">
  <div class="max-w-7xl mx-auto grid md:grid-cols-[auto_1fr] gap-8 md:gap-14 items-start">
    <p class="eyebrow md:pt-1.5">{t.security.eyebrow}</p>
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-[var(--color-foreground)] text-balance">
        {t.security.title}
      </h2>
      <p class="mt-4 text-base md:text-lg leading-relaxed text-[var(--color-muted)]">
        {t.security.body}
      </p>
      <a
        href={getLocalizedPath('/enterprise', lang)}
        class="mt-6 inline-flex items-center gap-2 text-base font-medium text-[var(--color-primary)] underline underline-offset-4 decoration-[var(--color-primary)]/30 hover:decoration-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]"
      >
        {t.security.linkLabel}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
