---
import type { Translations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/utils';
const { t, lang = 'en' } = Astro.props as { t: Translations; lang?: string };
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 border-b border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto flex items-center justify-between py-4 px-6">
    <a href="/">
      <img src="/images/logo/fineguide_lg.svg" alt="Fineguide" class="h-10" />
    </a>

    <div class="hidden md:flex items-center gap-6">
      <details class="group relative">
        <summary
          class="list-none cursor-pointer text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors flex items-center gap-1 [&::-webkit-details-marker]:hidden"
        >
          {t.nav.platform}
          <svg class="w-3.5 h-3.5 opacity-70 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </summary>
        <div
          class="absolute left-0 top-full z-50 mt-2 w-56 rounded-xl border border-[var(--color-border)] bg-white py-2 shadow-lg"
        >
          <a
            href={getLocalizedPath('/', lang)}
            class="block px-4 py-2 text-sm text-[var(--color-muted)] hover:bg-gray-50 hover:text-[var(--color-foreground)]"
            >{t.nav.overview}</a
          >
          <a
            href={getLocalizedPath('/ai-assistants', lang)}
            class="block px-4 py-2 text-sm text-[var(--color-muted)] hover:bg-gray-50 hover:text-[var(--color-foreground)]"
            >{t.nav.assistants}</a
          >
          <a
            href={getLocalizedPath('/crm', lang)}
            class="block px-4 py-2 text-sm text-[var(--color-muted)] hover:bg-gray-50 hover:text-[var(--color-foreground)]"
            >{t.nav.crm}</a
          >
          <a
            href={getLocalizedPath('/voice-qa', lang)}
            class="block px-4 py-2 text-sm text-[var(--color-muted)] hover:bg-gray-50 hover:text-[var(--color-foreground)]"
            >{t.nav.voiceQa}</a
          >
          <a
            href={getLocalizedPath('/voice-ai', lang)}
            class="block px-4 py-2 text-sm text-[var(--color-muted)] hover:bg-gray-50 hover:text-[var(--color-foreground)]"
            >{t.nav.voiceAi}</a
          >
          <a
            href={getLocalizedPath('/workspace', lang)}
            class="block px-4 py-2 text-sm text-[var(--color-muted)] hover:bg-gray-50 hover:text-[var(--color-foreground)]"
            >{t.nav.workspace}</a
          >
        </div>
      </details>
      <a href={getLocalizedPath('/pricing', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.pricing}</a>
      <a href={getLocalizedPath('/contact', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.contact}</a>
      <a href="https://fineguide.ai/blog" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.blog}</a>
    </div>

    <div class="flex items-center gap-3">
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors"
        aria-label={t.nav.menuLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <a
        id="nav-auth-desktop"
        href="https://app.fineguide.ai/login"
        data-dashboard-text={t.nav.dashboard}
        class="hidden md:inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all"
      >
        {t.nav.signIn}
      </a>
    </div>
  </div>

</nav>

<!-- Mobile menu overlay -->
<div id="mobile-overlay" class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm hidden md:hidden transition-opacity duration-300 opacity-0"></div>

<!-- Mobile menu panel -->
<div id="mobile-menu" class="fixed top-0 right-0 z-50 h-full w-72 max-w-[80vw] bg-white shadow-2xl translate-x-full transition-transform duration-300 ease-out md:hidden">
  <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--color-border)]">
    <img src="/images/logo/fineguide_lg.svg" alt="Fineguide" class="h-8" />
    <button id="mobile-menu-close" class="p-2 text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors" aria-label="Close menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="flex flex-col px-4 pt-4 gap-1">
    <p class="px-3 pt-1 pb-0.5 text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">{t.nav.platform}</p>
    <a href={getLocalizedPath('/', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.overview}</a>
    <a href={getLocalizedPath('/ai-assistants', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.assistants}</a>
    <a href={getLocalizedPath('/crm', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.crm}</a>
    <a href={getLocalizedPath('/voice-qa', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.voiceQa}</a>
    <a href={getLocalizedPath('/voice-ai', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.voiceAi}</a>
    <a href={getLocalizedPath('/workspace', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.workspace}</a>
    <div class="my-2 border-t border-[var(--color-border)]" />
    <a href={getLocalizedPath('/pricing', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.pricing}</a>
    <a href={getLocalizedPath('/contact', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.contact}</a>
    <a href="https://fineguide.ai/blog" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] hover:bg-gray-50 transition-colors py-2.5 px-3 rounded-lg">{t.nav.blog}</a>
    <div class="pt-4 mt-3 border-t border-[var(--color-border)]">
      <a
        id="nav-auth-mobile"
        href="https://app.fineguide.ai/login"
        data-dashboard-text={t.nav.dashboard}
        class="flex items-center justify-center gap-2 px-5 py-3 text-sm font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all"
      >
        {t.nav.signIn}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const closeBtn = document.getElementById('mobile-menu-close');

  function openMenu() {
    overlay?.classList.remove('hidden');
    requestAnimationFrame(() => overlay?.classList.add('opacity-100'));
    menu?.classList.remove('translate-x-full');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    overlay?.classList.remove('opacity-100');
    menu?.classList.add('translate-x-full');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => overlay?.classList.add('hidden'), 300);
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach(link =>
    link.addEventListener('click', closeMenu)
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('translate-x-full')) {
      closeMenu();
      btn?.focus();
    }
  });

  // Check if user is authenticated and update nav buttons accordingly
  (async () => {
    const APP_URL = 'https://app.fineguide.ai';
    const API_URL = `${APP_URL}/api/core`;

    try {
      const res = await fetch(`${API_URL}/auth/refresh`, {
        method: 'GET',
        credentials: 'include',
      });

      if (!res.ok) return;

      const desktopBtn = document.getElementById('nav-auth-desktop') as HTMLAnchorElement | null;
      const mobileBtn = document.getElementById('nav-auth-mobile') as HTMLAnchorElement | null;

      [desktopBtn, mobileBtn].forEach((link) => {
        if (!link) return;
        const dashboardText = link.dataset.dashboardText || 'Dashboard';
        link.href = APP_URL;
        // Preserve child SVG icon (mobile button), only replace text node
        const textNode = Array.from(link.childNodes).find((n) => n.nodeType === Node.TEXT_NODE);
        if (textNode) {
          textNode.textContent = dashboardText;
        } else {
          link.prepend(document.createTextNode(dashboardText));
        }
      });
    } catch {
      // Auth check failed silently — keep "Sign in" button
    }
  })();
</script>
