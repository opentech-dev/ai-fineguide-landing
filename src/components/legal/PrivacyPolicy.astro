---
// Privacy policy body, written against Moldova's Law No. 195/2024 on personal
// data protection (in force since 23 August 2026). Both languages live in this
// one file so the styles below reach both, and so the texts stay mirrored:
// change a section in one language, change it in the other.
//
// Facts it states, and where they come from:
// - trackers, storage keys, lifetimes: src/layouts/Layout.astro,
//   src/components/CookieConsent.astro, src/components/Navbar.astro,
//   the chat widget (ai-chat-injector), Dockerfile
// - hosting: ai-fineguide-project/docs/INFRASTRUCTURE.md (AWS us-east-1 for
//   the application, dedicated EU servers for the databases, Cloudflare)
// - vendors: ai-backoffice-api dependencies (Stripe, OpenAI, Anthropic,
//   Google Gemini, ElevenLabs, AWS S3 and SES)
// - regulator details: datepersonale.md
// Never write that we are "compliant" or "certified" (scripts/verify-claims.mjs).
import type { Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const updated = lang === 'ro' ? '15 septembrie 2026' : '15 September 2026';
const email = 'office@fineguide.ai';
---

