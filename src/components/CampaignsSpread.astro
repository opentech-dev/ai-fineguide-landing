---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };
const s = t.campaigns;
---

<section id="campaigns" class="band-tint scroll-mt-24 py-24 md:py-36 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5">{s.eyebrow}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
        {s.title}
      </h2>
      <p class="mt-6 text-lg text-[var(--color-muted)] leading-relaxed">
        {s.body}
      </p>
    </div>

    {/* The three campaign types are the CampaignType enum, not a chosen number —
        OUTREACH / SURVEY / PROMOTION. If a fourth is added this grid should grow. */}
    <ul class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-5">
      {s.types.map((c) => (
        <li class="rounded-2xl border border-[var(--color-border)] bg-white p-7 flex flex-col">
          <h3 class="text-lg font-semibold text-[var(--color-foreground)]">{c.name}</h3>
          <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">{c.desc}</p>
        </li>
      ))}
    </ul>

    <ul class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-4">
      {s.features.map((f) => (
        <li class="flex gap-3 text-base text-[var(--color-foreground)]">
          <span class="text-[var(--color-primary)] mt-1 shrink-0">—</span>
          <span class="leading-relaxed">{f}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
