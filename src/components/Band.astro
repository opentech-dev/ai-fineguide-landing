---
/**
 * One full-width section of a product page: eyebrow, heading, lead paragraph,
 * then the content in the slot.
 *
 * Pages alternate tones (light, dark, tint) instead of separating sections with
 * a border-top, so the tone is the only thing that changes from band to band.
 * Everything else, spacing, type scale and measure, is decided here once.
 */
interface Props {
  tone?: 'light' | 'dark' | 'tint';
  eyebrow: string;
  heading: string;
  body?: string;
  id?: string;
}

const { tone = 'light', eyebrow, heading, body, id } = Astro.props as Props;
const dark = tone === 'dark';
const sectionClass = {
  light: 'py-20 md:py-28',
  tint: 'band-tint py-20 md:py-28',
  dark: 'bg-[#0f1117] text-white dark-grain py-24 md:py-32',
}[tone];
---

<section id={id} class={`${sectionClass} px-6`}>
  <div class="max-w-7xl mx-auto">
    <p class={`${dark ? 'eyebrow-light' : 'eyebrow'} mb-5`}>{eyebrow}</p>
    <h2
      class={`text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-balance ${dark ? '' : 'text-[var(--color-foreground)]'}`}
    >
      {heading}
    </h2>
    {
      body && (
        <p
          class={`mt-6 max-w-4xl text-lg md:text-xl leading-relaxed text-pretty ${dark ? 'text-gray-300' : 'text-[var(--color-muted)]'}`}
        >
          {body}
        </p>
      )
    }
    <div class={dark ? 'mt-14' : 'mt-12'}>
      <slot />
    </div>
  </div>
</section>
