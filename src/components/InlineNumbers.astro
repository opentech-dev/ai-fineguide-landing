---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };
---

<section class="py-20 md:py-28 px-6 band-tint">
  <div class="max-w-7xl mx-auto">
    <p class="eyebrow mb-10">
      {t.numbers.eyebrow}
    </p>
    <div class="divide-y divide-[var(--color-border)]">
      {t.numbers.items.map((it) => (
        <p class="py-7 md:py-9 first:pt-0 last:pb-0 text-2xl md:text-3xl lg:text-[2.6rem] leading-[1.25] text-[var(--color-foreground)] font-light text-balance">
          <span class="font-semibold text-[var(--color-primary)] tracking-tight tnum">{it.figure}</span>
          <span class="text-[var(--color-muted)]"> &nbsp; {it.prose}</span>
        </p>
      ))}
    </div>
  </div>
</section>
