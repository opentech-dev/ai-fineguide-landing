---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };
---

<section class="py-20 md:py-28 px-6 band-tint">
  <div class="max-w-7xl mx-auto grid gap-12 lg:gap-16 lg:grid-cols-[1fr_minmax(0,26rem)] lg:items-center">
    <div>
      <p class="eyebrow mb-10">
        {t.numbers.eyebrow}
      </p>
      <div class="divide-y divide-[var(--color-border)]">
        {t.numbers.items.map((it) => (
          <p class="py-7 md:py-9 first:pt-0 last:pb-0 text-2xl md:text-3xl leading-[1.25] text-[var(--color-foreground)] font-light text-balance">
            <span class="font-semibold text-[var(--color-primary)] tracking-tight tnum">{it.figure}</span>
            <span class="text-[var(--color-muted)]"> &nbsp; {it.prose}</span>
          </p>
        ))}
      </div>
    </div>

    <figure>
      <img
        src="/images/photos/agent-call.jpg"
        alt={t.photos.agentHeadset}
        width="1408"
        height="768"
        class="w-full h-[300px] lg:h-[460px] object-cover rounded-2xl"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>
