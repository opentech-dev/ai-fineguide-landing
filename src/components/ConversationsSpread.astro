---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };
const s = t.conversations;
---

{/* Plain band by design: this sits between the tinted CRM spread above and the
    dark Voice band below, so tinting it would put two tints back to back. */}
<section id="messages" class="scroll-mt-24 py-24 md:py-36 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5">{s.eyebrow}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
        {s.title}
      </h2>
      <p class="mt-6 text-lg text-[var(--color-muted)] leading-relaxed">
        {s.body}
      </p>
    </div>

    {/* Two sub-topics, each with its own list, so this keeps a column layout —
        but as rule-topped columns rather than floating cards. Same vocabulary as
        EditorialRows: a hairline for structure, no box, no shadow. */}
    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-12">
      {s.columns.map((c) => (
        <div class="border-t border-[var(--color-border)] pt-7">
          <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-primary)]">
            {c.name}
          </h3>
          <p class="mt-3 text-base text-[var(--color-muted)] leading-relaxed">{c.desc}</p>
          <ul class="mt-7 flex flex-col gap-3.5">
            {c.features.map((f) => (
              <li class="flex gap-3 text-base text-[var(--color-foreground)]">
                <span class="text-[var(--color-accent)] mt-[3px] shrink-0">—</span>
                <span class="leading-relaxed">{f}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
