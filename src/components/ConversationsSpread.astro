---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };
const s = t.conversations;
---

{/* Plain band by design: this sits between the tinted CRM spread above and the
    dark Voice band below, so tinting it would put two tints back to back. */}
<section class="py-24 md:py-36 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5">{s.eyebrow}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
        {s.title}
      </h2>
      <p class="mt-6 text-lg text-[var(--color-muted)] leading-relaxed">
        {s.body}
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-6">
      {s.columns.map((c) => (
        <div class="rounded-2xl border border-[var(--color-border)] bg-white p-8 flex flex-col">
          <h3 class="text-xl font-semibold text-[var(--color-foreground)]">{c.name}</h3>
          <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">{c.desc}</p>
          <ul class="mt-7 flex flex-col gap-4">
            {c.features.map((f) => (
              <li class="flex gap-3 text-[15px] text-[var(--color-foreground)]">
                <span class="text-[var(--color-primary)] mt-1 shrink-0">—</span>
                <span class="leading-relaxed">{f}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
