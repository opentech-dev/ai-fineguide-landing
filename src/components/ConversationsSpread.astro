---
import type { Translations, Lang } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/utils';
const { t, lang = 'en' } = Astro.props as { t: Translations; lang?: Lang };
const s = t.conversations;
---

{/* Teaser only — see the note in CampaignsSpread. Plain band by design: it sits
    between the tinted CRM spread above and the dark Voice band below, so
    tinting it would put two tints back to back. */}
<section id="messages" class="scroll-mt-24 py-20 md:py-28 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5">{s.eyebrow}</p>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]"
      >
        {s.title}
      </h2>
      <p class="mt-6 text-lg text-[var(--color-muted)] leading-relaxed">
        {s.body}
      </p>
      <a
        href={getLocalizedPath('/messages', lang)}
        class="inline-flex items-center gap-1.5 mt-8 text-sm font-semibold text-[var(--color-primary)] hover:underline"
      >
        {s.linkLabel}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
