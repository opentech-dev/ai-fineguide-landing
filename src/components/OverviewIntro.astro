---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };
---

<section class="py-28 md:py-40 px-6 border-t border-[var(--color-border)]/60">
  <div class="max-w-7xl mx-auto">
    <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-primary)] mb-10">
      {t.overview.eyebrow}
    </p>
    <p class="text-2xl md:text-3xl leading-relaxed text-[var(--color-foreground)] max-w-7xl font-light">
      {t.overview.body}
    </p>

    <dl class="mt-20 md:mt-24 grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-10">
      {t.overview.modules.map((m) => (
        <div>
          <dt class="font-[var(--font-display)] text-2xl md:text-3xl font-semibold tracking-tight text-[var(--color-foreground)]">
            {m.name}
          </dt>
          <dd class="mt-2 text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
            {m.desc}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
