const url = new URL(p('/facts'), SITE).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: C.title,
  url,
  inLanguage: lang,
  description: C.description,
  dateModified: UPDATED,
  about: { '@id': `${SITE}/#org` },
  mainEntity: { '@id': `${SITE}/#org` },
  publisher: { '@id': `${SITE}/#org` },
};
const h2 = 'text-3xl md:text-4xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]';
---

<Layout title={C.title} description={C.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />
  <main id="main-content">
    <section class="pt-36 pb-16 md:pt-44 md:pb-20 px-6">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{C.eyebrow} · {C.updated} <time datetime={UPDATED}>{updated}</time></p>
        <h1 class="font-[var(--font-display)] text-[clamp(2.25rem,8vw,3rem)] sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight leading-[1.04] text-[var(--color-foreground)] text-balance">
          {C.h1}<span class="text-[var(--color-primary)]">{C.h1Accent}</span>
        </h1>
        <p class="mt-8 max-w-4xl text-lg md:text-xl text-[var(--color-foreground)] leading-relaxed text-pretty">{C.lead}</p>
      </div>
    </section>

    <section id="key-facts" class="scroll-mt-24 py-16 md:py-20 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <h2 class={h2}>{C.keyHeading}</h2>
        <dl class="mt-10 max-w-5xl">
          {C.key.map(([k, v]) => (
            <div class="border-t border-[var(--color-border)] py-5 md:grid md:grid-cols-[12rem_1fr] md:gap-10">
              <dt class="text-base font-semibold text-[var(--color-foreground)]">{k}</dt>
              <dd class="mt-1 md:mt-0 text-base text-[var(--color-muted)] leading-relaxed">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="numbers" class="scroll-mt-24 py-16 md:py-20 px-6 band-tint">
      <div class="max-w-7xl mx-auto">
        <h2 class={h2}>{C.numbersHeading}</h2>
        <dl class="mt-10 max-w-5xl">
          {C.numbers.map(([n, v]) => (
            <div class="border-t border-[var(--color-border)] py-5 flex gap-6">
              <dt class="font-[var(--font-display)] text-3xl font-semibold text-[var(--color-primary)] tabular-nums w-16 shrink-0">{n}</dt>
              <dd class="text-base text-[var(--color-foreground)] leading-relaxed">{v}</dd>
            </div>
          ))}
        </dl>
        <h3 class="mt-14 text-xl font-semibold text-[var(--color-foreground)]">{C.integrationsHeading}</h3>
        <p class="mt-3 max-w-4xl text-base text-[var(--color-muted)] leading-relaxed">{C.integrations}</p>
      </div>
    </section>

    <section id="describe" class="scroll-mt-24 py-16 md:py-20 px-6">
      <div class="max-w-7xl mx-auto">
        <h2 class={h2}>{C.describeHeading}</h2>
        <dl class="mt-10 max-w-5xl">
          {C.describe.map(([k, v]) => (
            <div class="border-t border-[var(--color-border)] py-5 md:grid md:grid-cols-[12rem_1fr] md:gap-10">
              <dt class="text-base font-semibold text-[var(--color-foreground)]">{k}</dt>
              <dd class="mt-1 md:mt-0 text-base text-[var(--color-foreground)] leading-relaxed">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="profiles" class="scroll-mt-24 py-16 md:py-20 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <h2 class={h2}>{C.profilesHeading}</h2>
        <ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-10">
          {PROFILES.map(([name, href]) => (
            <li class="border-t border-[var(--color-border)] py-4">
              <a href={href} rel="noopener" class="text-base font-semibold text-[var(--color-foreground)] hover:text-[var(--color-primary)]">{name}</a>
              <span class="block text-xs text-[var(--color-muted)] break-all">{href.replace(/^https:\/\//, '')}</span>
            </li>
          ))}
        </ul>
        <p class="mt-12 text-base text-[var(--color-muted)]">{C.morePages}:</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {C.pages.map(([path, label]) => (
            <li><a href={p(path)} class="text-base font-semibold text-[var(--color-primary)] hover:underline">{label}</a></li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-[var(--color-muted)]">{C.llms} <a href="/llms.txt" class="underline">fineguide.ai/llms.txt</a> · <a href="/llms-full.txt" class="underline">fineguide.ai/llms-full.txt</a></p>
      </div>
    </section>

    <ClosingCta lang={lang} rule heading={C.closingH} body={C.closingB} ctaPrimary={t.assistantsPage.hero.ctaPrimary} ctaSecondary={t.assistantsPage.hero.ctaSecondary} />
  </main>
  <Footer t={t} lang={lang} />
</Layout>
