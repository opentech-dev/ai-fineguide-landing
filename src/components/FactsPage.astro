---
/**
 * /facts/ (and /ro/facts/, /ru/facts/): "Fineguide at a glance" — the dated facts a journalist, a directory or an AI
 * assistant can quote as they are: the one-line description (the same words as the Organization data in Layout.astro
 * and public/llms.txt), the company, the product in numbers, where Fineguide is listed, and ready-to-use descriptions.
 * Every number here is on a product page or in llms.txt; change it there first.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import ClosingCta from './ClosingCta.astro';
