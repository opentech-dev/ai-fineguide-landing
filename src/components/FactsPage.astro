const UPDATED = '2026-11-27';
const from = fineguidePlansFrom(lang);
const updated = new Intl.DateTimeFormat({ en: 'en-GB', ro: 'ro-RO', ru: 'ru-RU' }[lang], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${UPDATED}T12:00:00Z`));
const p = (path: string) => getLocalizedPath(path, lang);

// The same entity everywhere (Layout.astro sameAs).
const PROFILES: Array<[string, string]> = [
  ['LinkedIn', 'https://www.linkedin.com/company/fineguide'],
  ['X', 'https://x.com/fineguide_ai'],
  ['YouTube', 'https://www.youtube.com/@fineguide'],
  ['Instagram', 'https://www.instagram.com/fineguide_ai/'],
  ['Facebook', 'https://www.facebook.com/61576825531903'],
