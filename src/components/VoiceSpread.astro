---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };
const s = t.voiceSpread;
---

<section class="py-24 md:py-36 px-6 bg-[#0f1117] text-white dark-grain">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <div class="lg:col-span-7">
      <p class="eyebrow-light mb-5">
        {s.eyebrow}
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight">
        {s.title}
      </h2>
      <p class="mt-6 text-lg text-gray-300 leading-relaxed">
        {s.body}
      </p>
      <ul class="mt-8 space-y-3">
        {s.features.map((f) => (
          <li class="flex gap-3 text-base text-gray-100">
            <svg class="w-[18px] h-[18px] mt-1 shrink-0 text-[#c7b8ff]" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.5 4.5L19 7.5" /></svg>
            <span class="leading-relaxed">{f}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-5">
      {/* Rendered on the band's own #0f1117 ground so it reads as part of the
          section rather than a pale panel dropped onto it. No browser frame:
          this is an illustration, not a screen capture. */}
      <img
        src="/images/illustrations/voiceqa-scoring-dark.jpg"
        alt={s.screenshotAlt}
        width="1376"
        height="768"
        class="w-full h-auto block rounded-xl"
        loading="lazy"
      />
    </div>
  </div>
</section>
