---
import type { Translations, Lang } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/utils';
const { t, lang = 'en' } = Astro.props as { t: Translations; lang?: Lang };
const { workspace, automations } = t.workspaceAutomations;
---

<section class="py-20 md:py-28 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-y-16 gap-x-12 lg:gap-x-20">
    <!-- Two independent modules share this row, so the anchors go on the
         columns, not the section: #automations on the section landed the
         reader at the Workspace heading. -->
    <div id="workspace-section" class="scroll-mt-24">
      <p class="eyebrow mb-5">
        {workspace.eyebrow}
      </p>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
        {workspace.title}
      </h2>
      <p class="mt-5 text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
        {workspace.body}
      </p>
      <ul class="mt-8 space-y-3">
        {workspace.features.map((f) => (
          <li class="flex gap-3 text-base text-[var(--color-foreground)]">
            <span class="text-[var(--color-primary)] mt-1">—</span>
            <span class="leading-relaxed">{f}</span>
          </li>
        ))}
      </ul>
    </div>

    <div id="automations" class="scroll-mt-24">
      <p class="eyebrow mb-5">
        {automations.eyebrow}
      </p>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
        {automations.title}
      </h2>
      <p class="mt-5 text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
        {automations.body}
      </p>
      <ul class="mt-8 space-y-3">
        {automations.features.map((f) => (
          <li class="flex gap-3 text-base text-[var(--color-foreground)]">
            <span class="text-[var(--color-primary)] mt-1">—</span>
            <span class="leading-relaxed">{f}</span>
          </li>
        ))}
      </ul>
      <a
        href={getLocalizedPath('/automations', lang)}
        class="inline-flex items-center gap-1.5 mt-8 text-sm font-semibold text-[var(--color-primary)] hover:underline"
      >
        {automations.linkLabel}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <figure class="md:col-span-2">
      <img
        src="/images/photos/tablet-review.jpg"
        alt={t.photos.tabletReview}
        width="1376"
        height="768"
        class="w-full h-[260px] md:h-[380px] object-cover rounded-2xl"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>
