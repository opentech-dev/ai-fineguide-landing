---
/**
 * The MCP page, one component for /mcp/, /ro/mcp/ and /ru/mcp/: the server's address with a copy button, what an AI
 * app can do through it, how to connect each client, how sign-in keeps it to the person's own rights, the tools it
 * lists, and the questions. Copy and facts: src/data/mcp.ts.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { MCP_AREA_COUNTS, MCP_COPY, MCP_ENDPOINT, MCP_TOOL_GROUPS, MCP_TOTAL_ACTIONS } from '../data/mcp';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const c = MCP_COPY[lang];
const SITE = 'https://fineguide.ai';
const pageUrl = new URL(getLocalizedPath('/mcp', lang), SITE).href;

// The publisher as the owner states it (2026-11-25): FineGuide, a product of Eightcell Labs, Inc. (Delaware, USA).
const publisher = {
  '@type': 'Organization',
  name: 'FineGuide',
  url: `${SITE}/`,
  email: 'ops@fineguide.ai',
  telephone: '+1-408-313-8452',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Eightcell Labs, Inc.',
    address: { '@type': 'PostalAddress', addressRegion: 'DE', addressCountry: 'US' },
  },
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'FineGuide MCP server',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Model Context Protocol server',
    operatingSystem: 'Web',
    url: pageUrl,
    inLanguage: lang,
    description: c.meta.description,
    featureList: MCP_TOOL_GROUPS.flatMap((g) => g.tools.map(([name]) => `${name}: ${c.tools.lines[name]}`)),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: c.howto.name,
    inLanguage: lang,
    step: c.howto.steps.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const h2 = 'text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-balance';
const kindClass = {
  read: 'bg-gray-100 text-gray-700',
  change: 'bg-[var(--color-primary)]/10 text-[var(--color-primary)]',
  meta: 'bg-[#0f1117] text-white',
};
---

<Layout title={c.meta.title} description={c.meta.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <!-- Hero, with the address -->
    <section class="pt-36 pb-20 md:pt-44 md:pb-24 px-6">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{c.hero.eyebrow}</p>
        <h1 class="font-[var(--font-display)] text-[clamp(2.25rem,9vw,3rem)] sm:text-6xl md:text-7xl font-semibold tracking-tight leading-[1.02] text-[var(--color-foreground)] text-balance">
          {c.hero.title}
          <span class="text-[var(--color-primary)]">{c.hero.titleAccent}</span>
        </h1>
        <p class="mt-8 max-w-4xl text-xl md:text-2xl text-[var(--color-muted)] leading-relaxed text-pretty">{c.hero.subtitle}</p>

        <div class="mt-12 max-w-3xl rounded-xl border border-[var(--color-border)] bg-[#0f1117] p-5 md:p-6 text-white">
          <p class="eyebrow-light mb-3">{c.endpoint.label}</p>
          <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <code class="flex-1 min-w-0 break-all font-mono text-base md:text-lg text-[#c7b8ff]">{MCP_ENDPOINT}</code>
            <button
              type="button"
              class="mcp-copy shrink-0 inline-flex items-center justify-center px-4 py-2 text-sm font-semibold rounded-lg bg-white text-[#0f1117] hover:opacity-90 transition-opacity"
              data-copy={MCP_ENDPOINT}
              data-done={c.endpoint.copied}
            >
              {c.endpoint.copy}
            </button>
          </div>
          <p class="mt-3 text-sm text-gray-400">{c.endpoint.note}</p>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="https://app.fineguide.ai/register" class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all">{c.hero.ctaPrimary}</a>
          <a href="#connect" class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-[var(--color-foreground)] border border-[var(--color-border)] hover:bg-gray-50 rounded-lg transition-all">{c.hero.ctaSecondary}</a>
        </div>
      </div>
    </section>

    <!-- What it can do -->
    <section class="py-20 md:py-28 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{c.can.eyebrow}</p>
        <h2 class={`${h2} text-[var(--color-foreground)]`}>{c.can.heading}</h2>
        <p class="mt-6 max-w-4xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">{c.can.body}</p>
        <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-10">
          {c.can.items.map((item) => (
            <div class="border-t border-[var(--color-border)] pt-5">
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-foreground)]">{item.title}</h3>
              <p class="mt-3 text-base text-[var(--color-muted)] leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Connect -->
    <section id="connect" class="scroll-mt-24 py-20 md:py-28 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{c.setup.eyebrow}</p>
        <h2 class={`${h2} text-[var(--color-foreground)]`}>{c.setup.heading}</h2>
        <p class="mt-6 max-w-4xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">{c.setup.body}</p>
        <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">
          {c.setup.clients.map((client) => (
            <div class="border-t border-[var(--color-border)] pt-5 min-w-0">
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-foreground)]">{client.name}</h3>
              <ol class="mt-4 space-y-2 list-decimal pl-5 text-base text-[var(--color-muted)] leading-relaxed">
                {client.steps.map((step) => <li>{step}</li>)}
              </ol>
              {client.code && (
                <div class="mt-4 rounded-lg bg-[#0f1117] text-white">
                  <div class="flex items-center justify-between px-4 pt-3">
                    <span class="text-xs text-gray-400">{client.codeLabel}</span>
                    <button type="button" class="mcp-copy text-xs font-semibold text-[#c7b8ff] hover:underline" data-copy={client.code} data-done={c.endpoint.copied}>{c.endpoint.copy}</button>
                  </div>
                  <pre class="overflow-x-auto px-4 pb-4 pt-2 text-sm leading-relaxed"><code class="font-mono">{client.code}</code></pre>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sign-in and safety (dark editorial break) -->
    <section class="py-24 md:py-32 px-6 bg-[#0f1117] text-white dark-grain">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow-light mb-5">{c.safety.eyebrow}</p>
        <h2 class={h2}>{c.safety.heading}</h2>
        <p class="mt-6 max-w-4xl text-lg md:text-xl text-gray-300 leading-relaxed">{c.safety.body}</p>
        <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
          {c.safety.items.map((item) => (
            <div class="border-t border-white/10 pt-5">
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-white">{item.title}</h3>
              <p class="mt-3 text-base text-gray-300 leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tools -->
    <section id="tools" class="scroll-mt-24 py-20 md:py-28 px-6">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{c.tools.eyebrow}</p>
        <h2 class={`${h2} text-[var(--color-foreground)]`}>{c.tools.heading}</h2>
        <p class="mt-6 max-w-4xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">{c.tools.body}</p>
        <div class="mt-14 grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-12">
          {MCP_TOOL_GROUPS.map((group) => (
            <div class="min-w-0">
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-foreground)]">{c.tools.groups[group.key]}</h3>
              <ul class="mt-4">
                {group.tools.map(([name, kind]) => (
                  <li class="border-t border-[var(--color-border)] py-3">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <code class="font-mono text-sm text-[var(--color-foreground)] break-all">{name}</code>
                      <span class={`text-xs px-2 py-0.5 rounded-full ${kindClass[kind]}`}>{c.tools.kinds[kind]}</span>
                    </div>
                    <p class="mt-1 text-sm text-[var(--color-muted)] leading-relaxed">{c.tools.lines[name]}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-20 max-w-3xl">
          <h3 class="text-2xl md:text-3xl font-semibold tracking-tight text-[var(--color-foreground)]">{c.tools.allHeading}</h3>
          <table class="mt-6 w-full text-left">
            <tbody>
              {MCP_AREA_COUNTS.map(([key, count]) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-3 pr-6 text-base text-[var(--color-foreground)]">{c.tools.areas[key]}</td>
                  <td class="py-3 text-right font-mono text-base text-[var(--color-foreground)]">{count}</td>
                </tr>
              ))}
              <tr class="border-t-2 border-[var(--color-foreground)]">
                <td class="py-3 pr-6 text-base font-semibold text-[var(--color-foreground)]">{c.tools.total}</td>
                <td class="py-3 text-right font-mono text-base font-semibold text-[var(--color-foreground)]">{MCP_TOTAL_ACTIONS}</td>
              </tr>
            </tbody>
          </table>
          <p class="mt-6 text-base text-[var(--color-muted)] leading-relaxed">
            {c.tools.allBody} <code class="font-mono text-sm break-all">{MCP_ENDPOINT}?tools=all</code>
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ, visible: the FAQPage structured data repeats these words -->
    <section id="faq" class="scroll-mt-24 py-20 md:py-28 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <h2 class={`${h2} text-[var(--color-foreground)]`}>{c.faqHeading}</h2>
        <dl class="mt-12 max-w-4xl">
          {c.faq.map((f) => (
            <div class="border-t border-[var(--color-border)] py-6">
              <dt class="text-lg md:text-xl font-semibold text-[var(--color-foreground)]">{f.q}</dt>
              <dd class="mt-3 text-base text-[var(--color-muted)] leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-12 max-w-4xl border-t border-[var(--color-border)] pt-6">
          <p class="text-lg font-semibold text-[var(--color-foreground)]">{c.contact.heading}</p>
          <p class="mt-2 text-base text-[var(--color-muted)]">
            <a href="mailto:ops@fineguide.ai" class="hover:text-[var(--color-foreground)] underline underline-offset-2">ops@fineguide.ai</a>
            {' · '}
            <a href="tel:+14083138452" class="hover:text-[var(--color-foreground)] underline underline-offset-2">+1 408 313 8452</a>
          </p>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{c.contact.company}</p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 md:py-32 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)] text-balance">{c.finalCta.heading}</h2>
        <p class="mt-5 text-lg text-[var(--color-muted)] leading-relaxed">{c.finalCta.subtitle}</p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.fineguide.ai/register" class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all">{c.finalCta.primary}</a>
          <a href={getLocalizedPath('/contact', lang)} class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-[var(--color-foreground)] border border-[var(--color-border)] hover:bg-gray-50 rounded-lg transition-all">{c.finalCta.secondary}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} lang={lang} />
</Layout>

<script>
  // Copy buttons: the address and the setup snippets. Without the clipboard API the text stays selectable.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.mcp-copy')) {
    const label = button.textContent ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = button.dataset.done ?? label;
        setTimeout(() => (button.textContent = label), 1800);
      } catch {
        // Nothing to do: the reader can select the text.
      }
    });
  }
</script>
