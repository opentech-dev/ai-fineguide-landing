---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };

// Every figure here comes from the API's own config, same as PricingPlans:
//   seats    NEW_LADDER_2026[].extraSeatPrice        20 / 18 / 15
//   credits  NEW_LADDER_2026[].additionalMessagePrice 0.045 / 0.04 / 0.03 / 0.024
//   context  STORAGE_PACKS['kb-context-5m']           EUR 20 / month, +5,000,000 chars
// scripts/verify-pricing.mjs asserts all of them against those files.
const iconPaths: Record<string, string> = {
  seat: 'M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z',
  credit: 'M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3',
  context: 'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25',
};
---

<section class="py-20 md:py-28 px-6 band-tint">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-14">
      <p class="eyebrow mb-4">{t.pricingAddons.eyebrow}</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{t.pricingAddons.heading}</h2>
      <p class="text-[var(--color-muted)] text-lg">{t.pricingAddons.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {t.pricingAddons.items.map((item) => (
        <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 flex flex-col">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-lg bg-[var(--color-primary)]/8 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[item.icon]} />
              </svg>
            </div>
            <h3 class="font-semibold text-lg">{item.title}</h3>
          </div>

          <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-5">{item.body}</p>

          <div class="mt-auto space-y-2 pt-4 border-t border-[var(--color-border)]">
            {item.rates.map((rate) => (
              <div class="flex items-center justify-between gap-4">
                <span class="text-sm text-[var(--color-muted)]">{rate.label}</span>
                <span class="text-sm font-semibold text-[var(--color-foreground)] tnum whitespace-nowrap">{rate.value}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-[var(--color-muted)] max-w-3xl">{t.pricingAddons.footnote}</p>
  </div>
</section>
