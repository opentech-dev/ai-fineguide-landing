---
import Band from './Band.astro';
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };

// Every figure here comes from the API's own config, same as PricingPlans:
//   seats    NEW_LADDER_2026[].extraSeatPrice        20 / 18 / 15
//   credits  NEW_LADDER_2026[].additionalMessagePrice 0.045 / 0.04 / 0.03 / 0.024
//   context  STORAGE_PACKS['kb-context-5m']           EUR 20 / month, +5,000,000 chars
// Top-ups and Context Packs have no plan check, so both are sold on Free too.
// scripts/verify-pricing.mjs asserts the figures against those files.
const a = t.pricingAddons;
---

<Band tone="tint" eyebrow={a.eyebrow} heading={a.heading} body={a.subtitle}>
  <div class="grid md:grid-cols-3 gap-x-10 gap-y-12">
    {a.items.map((item) => (
      <div class="flex flex-col border-t border-[var(--color-border)] pt-5">
        <h3 class="text-lg font-semibold text-[var(--color-foreground)]">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{item.body}</p>
        <dl class="mt-auto pt-6 space-y-2">
          {item.rates.map((rate) => (
            <div class="flex items-center justify-between gap-4 border-t border-[var(--color-border)] pt-2">
              <dt class="text-sm text-[var(--color-muted)]">{rate.label}</dt>
              <dd class="text-sm font-semibold text-[var(--color-foreground)] tnum whitespace-nowrap">{rate.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
  <p class="mt-10 text-sm text-[var(--color-muted)] max-w-3xl">{a.footnote}</p>
</Band>
