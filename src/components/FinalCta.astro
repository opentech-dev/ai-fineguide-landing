---
import type { Translations, Lang } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/utils';
const { t, lang = 'en' } = Astro.props as { t: Translations; lang?: Lang };
---

<section class="py-20 md:py-28 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="relative isolate overflow-hidden rounded-[22px] px-6 py-20 md:px-16 md:py-28 text-center">
      <img
        src="/images/photos/office-golden.jpg"
        alt=""
        aria-hidden="true"
        width="1584"
        height="672"
        class="absolute inset-0 -z-20 w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 -z-10 cta-scrim"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.05] text-white text-balance">
          {t.finalCta.heading}
        </h2>
        <p class="mt-6 text-lg md:text-xl text-white/85 leading-relaxed max-w-2xl mx-auto">
          {t.finalCta.body}
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://app.fineguide.ai/register"
            class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-[var(--color-primary)] bg-white hover:bg-white/90 rounded-lg transition-all"
          >
            {t.finalCta.ctaPrimary}
          </a>
          <a
            href={getLocalizedPath('/enterprise', lang)}
            class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white border border-white/30 hover:border-white/70 hover:bg-white/5 rounded-lg transition-all"
          >
            {t.finalCta.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
