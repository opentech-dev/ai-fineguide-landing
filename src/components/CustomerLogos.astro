---
import type { Translations } from '../i18n/utils';
const { t } = Astro.props as { t: Translations };

/* Real customers, from public/images/companies/. These files were already in
   the repo but were not rendered anywhere on the site.
   Several are white on transparent, which vanished on the light background.
   brightness-0 renders every mark as one dark silhouette, so they read the same. */
const customers = [
  { name: 'STMD', file: 'STMD-logo.webp' },
  { name: 'Cadastru', file: 'cadastru.png' },
  { name: 'Dev-Aid', file: 'dev-aid.png' },
  { name: 'Fantastic Engineering', file: 'fantastic-eng.webp' },
  { name: 'Moving Pictures', file: 'moving_pictures.png' },
  { name: 'Profmet', file: 'profmet.png' },
  { name: 'Technovator', file: 'technovator.png' },
  { name: 'Unde.io', file: 'unde_io.png' },
];
---

<section class="pb-4 pt-2 md:pb-10 md:pt-4 px-6">
  <div class="max-w-7xl mx-auto">
    <p class="text-center text-sm text-[var(--color-muted)] mb-8">
      {t.customerLogos.eyebrow}
    </p>
    <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-7 md:gap-x-14">
      {customers.map((c) => (
        <li>
          <img
            src={`/images/companies/${c.file}`}
            alt={c.name}
            class="h-7 md:h-8 w-auto object-contain brightness-0 opacity-45 transition duration-200 hover:opacity-80"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
