---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { Lang, Translations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/utils';

type ModulePageContent = Translations['assistantsPage'];

const { t, lang, page }: { t: Translations; lang: Lang; page: ModulePageContent } = Astro.props;
---

<Layout title={page.meta.title} description={page.meta.description} lang={lang}>
  <Navbar t={t} lang={lang} />
  <section id="main-content" class="pt-28 pb-12 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight">
        {page.hero.title}
        <span class="text-[var(--color-primary)]">{page.hero.titleAccent}</span>
      </h1>
      <p class="mt-6 text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
        {page.hero.subtitle}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://app.fineguide.ai/login"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-xl transition-all"
        >
          {page.hero.ctaPrimary}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg
          >
        </a>
        <a
          href={getLocalizedPath('/schedule-demo', lang)}
          class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-[var(--color-foreground)] bg-white border border-[var(--color-border)] hover:border-[#d1d5e0] rounded-xl transition-all"
        >
          {page.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-6 pb-20 space-y-16">
    {
      page.sections.map((block) => (
        <section class="reveal">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">{block.heading}</h2>
          <p class="text-[var(--color-muted)] text-lg leading-relaxed">{block.body}</p>
        </section>
      ))
    }
  </div>

  <section class="py-20 md:py-28 px-6 bg-[#1a1f2e] dark-grain">
    <div class="max-w-3xl mx-auto text-center reveal">
      <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">
        {page.pageCta.heading}
        <span class="text-[var(--color-primary-foreground)]"> {page.pageCta.headingAccent}</span>{page.pageCta.headingSuffix}
      </h2>
      <p class="text-gray-400 text-lg mb-10">
        {page.pageCta.subtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://app.fineguide.ai/login"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-xl transition-all"
        >
          {page.pageCta.ctaPrimary}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg
          >
        </a>
        <a
          href={getLocalizedPath('/schedule-demo', lang)}
          class="inline-flex items-center justify-center gap-2 px-10 py-4 text-base font-semibold text-white border border-white/20 hover:border-white/40 rounded-xl transition-all"
        >
          {page.pageCta.ctaSecondary}
        </a>
      </div>
    </div>
  </section>

  <Footer t={t} lang={lang} />
</Layout>
