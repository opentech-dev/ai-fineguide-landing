---
import type { Translations, Lang } from '../i18n/utils';
import { LANGS, LANG_NAMES, getLocalizedPath, switchLangPath } from '../i18n/utils';
import { MCP_NAV_LABEL } from '../data/mcp';
const { t, lang = 'en' } = Astro.props as { t: Translations; lang?: Lang };

const currentPath = Astro.url.pathname;
// The blog is in one language: from a post, another language's door is its home page, not a /ro/blog/ address
// that only redirects back.
const switches = LANGS.filter((l) => l !== lang).map((l) => ({
  lang: l,
  name: LANG_NAMES[l],
  href: currentPath.startsWith('/blog') ? switchLangPath('/', l) : switchLangPath(currentPath, l),
}));
// The capability pages (src/data/solutions), under their own heading so the product list stays the modules.
const solutions = {
  en: { heading: 'Solutions', items: [['/business-automation', 'AI business automation'], ['/omnichannel-chatbot', 'Omnichannel AI chatbot'], ['/ai-customer-service', 'AI customer service'], ['/call-center', 'Call center software'], ['/help-desk', 'Help desk'], ['/knowledge-base', 'AI knowledge base']] },
  ro: { heading: 'Soluții', items: [['/business-automation', 'Automatizarea afacerii cu AI'], ['/omnichannel-chatbot', 'Chatbot AI omnicanal'], ['/ai-customer-service', 'Customer service cu AI'], ['/call-center', 'Soft pentru call center'], ['/help-desk', 'Helpdesk'], ['/knowledge-base', 'Bază de cunoștințe AI']] },
  ru: { heading: 'Решения', items: [['/business-automation', 'Автоматизация бизнеса с ИИ'], ['/omnichannel-chatbot', 'Омниканальный ИИ-чат-бот'], ['/ai-customer-service', 'ИИ для обслуживания клиентов'], ['/call-center', 'Программа для колл-центра'], ['/help-desk', 'Хелпдеск'], ['/knowledge-base', 'База знаний с ИИ']] },
}[lang];
// The channel and industry pages (src/data/solutions), each language's labels.
const channels = {
  en: { heading: 'Channels', items: [['/website-ai-chatbot', 'Website chat'], ['/whatsapp-ai-chatbot', 'WhatsApp'], ['/telegram-ai-bot', 'Telegram'], ['/instagram-ai-chatbot', 'Instagram'], ['/messenger-ai-chatbot', 'Messenger'], ['/jivochat-ai-bot', 'JivoChat'], ['/ai-email-assistant', 'Email'], ['/voice-ai', 'Phone']] },
  ro: { heading: 'Canale', items: [['/website-ai-chatbot', 'Chat pe site'], ['/whatsapp-ai-chatbot', 'WhatsApp'], ['/telegram-ai-bot', 'Telegram'], ['/instagram-ai-chatbot', 'Instagram'], ['/messenger-ai-chatbot', 'Messenger'], ['/jivochat-ai-bot', 'JivoChat'], ['/ai-email-assistant', 'Email'], ['/voice-ai', 'Telefon']] },
  ru: { heading: 'Каналы', items: [['/website-ai-chatbot', 'Чат на сайте'], ['/whatsapp-ai-chatbot', 'WhatsApp'], ['/telegram-ai-bot', 'Telegram'], ['/instagram-ai-chatbot', 'Instagram'], ['/messenger-ai-chatbot', 'Messenger'], ['/jivochat-ai-bot', 'JivoChat'], ['/ai-email-assistant', 'Почта'], ['/voice-ai', 'Телефон']] },
}[lang];
const industries = {
  en: { heading: 'Industries', items: [['/industries/real-estate', 'Real estate'], ['/industries/ecommerce', 'Online stores'], ['/industries/clinics', 'Clinics and services'], ['/industries/education', 'Education'], ['/industries/hotels-travel', 'Hotels and travel'], ['/call-center', 'Call centers']] },
  ro: { heading: 'Domenii', items: [['/industries/real-estate', 'Imobiliare'], ['/industries/ecommerce', 'Magazine online'], ['/industries/clinics', 'Clinici și servicii'], ['/industries/education', 'Educație'], ['/industries/hotels-travel', 'Hoteluri și turism'], ['/call-center', 'Call centere']] },
  ru: { heading: 'Отрасли', items: [['/industries/real-estate', 'Недвижимость'], ['/industries/ecommerce', 'Интернет-магазины'], ['/industries/clinics', 'Клиники и услуги'], ['/industries/education', 'Образование'], ['/industries/hotels-travel', 'Отели и туризм'], ['/call-center', 'Колл-центры']] },
}[lang];
// Company column extras: the "best X" guides (src/data/best) and the dated facts page.
const extras = {
  en: { guides: 'Software guides', facts: 'Fineguide at a glance' },
  ro: { guides: 'Ghiduri de software', facts: 'Fineguide pe scurt' },
  ru: { guides: 'Обзоры программ', facts: 'Fineguide в фактах' },
}[lang];
const legal = {
  en: { rights: '#your-rights', dataProtection: 'Data protection', cookies: 'Cookie settings' },
  ro: { rights: '#drepturile-tale', dataProtection: 'Protecția datelor', cookies: 'Setări cookie' },
  ru: { rights: '#your-rights', dataProtection: 'Защита данных', cookies: 'Настройки cookie' },
}[lang];
---

<footer class="border-t border-[var(--color-border)]/50 py-12 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-start justify-between gap-8 mb-8">
      <div>
        <img src="/images/logo/fineguide_lg.svg" alt="Fineguide.ai" width="97" height="28" class="h-7 w-auto" />
        <p class="text-sm text-[var(--color-muted)] mt-2 max-w-xs">
          {t.footer.tagline}
        </p>
      </div>
      <div class="flex flex-wrap gap-x-12 gap-y-8">
        <div>
          <p class="text-sm font-semibold text-[var(--color-foreground)] mb-3">{t.footer.product}</p>
          <div class="flex flex-col gap-2">
            <a href={getLocalizedPath('/', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.overview}</a>
            <a href={getLocalizedPath('/ai-assistants', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.assistants}</a>
            <a href={getLocalizedPath('/crm', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.crm}</a>
            <a href={getLocalizedPath('/messages', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.messages}</a>
            <a href={getLocalizedPath('/voice-qa', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.voiceQa}</a>
            <a href={getLocalizedPath('/voice-ai', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.voiceAi}</a>
            <a href={getLocalizedPath('/campaigns', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.campaigns}</a>
            <a href={getLocalizedPath('/workspace', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.workspace}</a>
            <a href={getLocalizedPath('/automations', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.automations}</a>
            <a href={getLocalizedPath('/mcp', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{MCP_NAV_LABEL[lang]}</a>
            <a href={getLocalizedPath('/pricing', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.nav.pricing}</a>
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-foreground)] mb-3">{solutions.heading}</p>
          <div class="flex flex-col gap-2">
            {solutions.items.map(([href, label]) => (
              <a href={getLocalizedPath(href, lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{label}</a>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-foreground)] mb-3">{channels.heading}</p>
          <div class="flex flex-col gap-2">
            {channels.items.map(([href, label]) => (
              <a href={getLocalizedPath(href, lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{label}</a>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-foreground)] mb-3">{industries.heading}</p>
          <div class="flex flex-col gap-2">
            {industries.items.map(([href, label]) => (
              <a href={getLocalizedPath(href, lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{label}</a>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-foreground)] mb-3">{t.footer.company}</p>
          <div class="flex flex-col gap-2">
            <a href={getLocalizedPath('/about', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.about}</a>
            <a href={getLocalizedPath('/facts', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{extras.facts}</a>
            <a href={getLocalizedPath('/compare', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.compare}</a>
            <a href={getLocalizedPath('/best', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{extras.guides}</a>
            <a href={getLocalizedPath('/enterprise', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.enterprise}</a>
            <a href={getLocalizedPath('/partners', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.partners}</a>
            <a href={getLocalizedPath('/schedule-demo', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.scheduleDemo}</a>
            <a href={getLocalizedPath('/contact', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.contact}</a>
          </div>
        </div>
      </div>
    </div>
    <div class="border-t border-[var(--color-border)]/50 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-[var(--color-muted)]">
        &copy; {new Date().getFullYear()} Fineguide.ai. {t.footer.copyright}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a href={getLocalizedPath('/privacy-policy', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.privacy}</a>
        <a href={getLocalizedPath('/terms-of-service', lang)} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{t.footer.terms}</a>
        <a href={getLocalizedPath('/privacy-policy', lang) + legal.rights} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{legal.dataProtection}</a>
        <button type="button" onclick="window.fgOpenCookieSettings && window.fgOpenCookieSettings()" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors">{legal.cookies}</button>
        <span class="text-[var(--color-border)]">|</span>
        {switches.map((s, i) => (
        <a
          href={s.href}
          hreflang={s.lang}
          lang={s.lang}
          onclick={`localStorage.setItem('fg-lang','${s.lang}');document.cookie='fg-lang=${s.lang};path=/;max-age=31536000;SameSite=Lax'`}
          class="inline-flex items-center gap-1.5 text-sm text-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors"
        >
          {i === 0 && <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.732-3.558" /></svg>}
          {s.name}
        </a>
        ))}
      </div>
    </div>
  </div>
</footer>
