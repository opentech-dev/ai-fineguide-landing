---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import EditorialRows from '../../components/EditorialRows.astro';
import RuleList from '../../components/RuleList.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const p = t.crmPage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fineguide CRM',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: p.meta.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<Layout title={p.meta.title} description={p.meta.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <PageHero eyebrow={p.intro.eyebrow} lang={lang} {...p.hero}>
      {/* A generated illustration, not a screenshot: the product shot that used
          to sit here came from a live account and showed a customer's data.
          Replace it with a screenshot from the demo workspace when one exists. */}
      <img
        src="/images/illustrations/crm-record.png"
        alt={p.intro.screenshotAlt}
        width="1376"
        height="768"
        class="w-full h-auto rounded-xl border border-[var(--color-border)] shadow-2xl"
        loading="eager"
      />
    </PageHero>

    <Band tone="dark" eyebrow={p.surfaces.eyebrow} heading={p.surfaces.heading} body={p.surfaces.body}>
      <EditorialRows variant="dark" items={p.surfaces.items.map((i) => ({ term: i.name, desc: i.desc }))} />
    </Band>

    <Band eyebrow={p.customerRecord.eyebrow} heading={p.customerRecord.heading} body={p.customerRecord.body}>
      <RuleList items={p.customerRecord.bullets} />
    </Band>

    <Band tone="tint" eyebrow={p.work.eyebrow} heading={p.work.heading} body={p.work.body}>
      <EditorialRows items={p.work.blocks.map((b) => ({ term: b.title, desc: b.body }))} />
    </Band>

    <Band eyebrow={p.dataFlow.eyebrow} heading={p.dataFlow.heading} body={p.dataFlow.body}>
      <RuleList items={p.dataFlow.bullets} />
    </Band>

    <ClosingCta lang={lang} rule {...p.finalCta} />
  </main>

  <Footer t={t} lang={lang} />
</Layout>
