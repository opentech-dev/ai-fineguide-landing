---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PrivacyPolicy from '../../components/legal/PrivacyPolicy.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<Layout
  title="Politica de confidențialitate | Fineguide.ai"
  description="Cum prelucrează Fineguide.ai datele personale conform Legii nr. 195/2024: ce colectăm, de ce, cui le transmitem, cât le păstrăm și ce drepturi ai."
  lang={lang}
>
  <Navbar t={t} lang={lang} />

  <PrivacyPolicy lang={lang} />

  <Footer t={t} lang={lang} />
</Layout>

