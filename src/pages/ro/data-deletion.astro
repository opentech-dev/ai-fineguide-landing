---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import DataDeletion from '../../components/legal/DataDeletion.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<Layout
  title="Ștergerea datelor primite de la Meta | Fineguide.ai"
  description="Cum ceri Fineguide.ai să șteargă datele primite de la Facebook, Instagram sau WhatsApp, ca firmă sau ca persoană."
  lang={lang}
>
  <Navbar t={t} lang={lang} />

  <main id="main-content">

  <DataDeletion lang={lang} />

  </main>

  <Footer t={t} lang={lang} />
</Layout>

