---
import ComparePage from '../../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs Bitrix24: alternativă Bitrix24 cu AI',
  description: 'Alternativă Bitrix24 comparată punct cu punct: AI, canale de contact center, telefonie, evaluarea apelurilor și ediția on-premise, din surse oficiale.',
  crumb: 'Bitrix24',
  h1: 'Fineguide vs Bitrix24:',
  h1Accent: 'un CRM construit în jurul conversației',
  shortAnswer:
    'Bitrix24 este un spațiu de lucru vast (CRM, sarcini, proiecte, site-uri, HR și telefonie), cu ediție on-premise. Fineguide este mai îngust: un CRM construit pe AI, în care asistenții răspund pe chat, email și la telefon din aceeași fișă de client și în care fiecare apel înregistrat poate fi evaluat. Alege Bitrix24 pentru un spațiu de lucru al întregii companii; alege Fineguide când munca înseamnă conversații și apeluri cu clienții.',
  tableHeading: 'Bitrix24 și Fineguide, rând cu rând',
  competitorStronger: {
    heading: 'Unde Bitrix24 este mai puternic',
    items: [
      { text: 'Amploare. Sarcini și proiecte (Kanban și Gantt), calendare comune, chat și apeluri video, constructor de site-uri, semnătură electronică, unelte de HR și pontaj, în același cont cu CRM-ul.', refs: ['bitrix24:plans'] },
      { text: 'Telefonie proprie: închiriezi un număr virtual de la furnizorul integrat sau conectezi centrala de birou ori din cloud prin conectorul SIP; call tracking pe Professional.', refs: ['bitrix24:telephony', 'bitrix24:plans'] },
      { text: 'Ediție on-premise gata de instalat, cu acces la codul sursă. Instalarea on-premise a Fineguide se stabilește printr-un contract Enterprise.', refs: ['bitrix24:plans', 'fg:fg-enterprise'] },
      { text: 'Mai multe canale de contact center într-un singur loc, inclusiv Viber și Bitrix24 Network; Fineguide nu are Viber în listă.', refs: ['bitrix24:channels'] },
    ],
  },
  fineguideStronger: {
    heading: 'Unde Fineguide este mai puternic',
    items: [
      { text: 'AI care le răspunde clienților. Asistenții învață din adresele, documentele și PDF-urile tale, răspund în widgetul de pe site, pe WhatsApp, Telegram, Instagram, Messenger, Slack și Discord, scriu câmpurile alese de tine în lead-urile din CRM (pe planurile plătite) și predau conversația unui om.', refs: ['fg:fg-assistants'] },
      { text: 'AI pe apeluri în direct, prin SIP-ul tău, în 14 limbi, inclusiv română și rusă, plus campanii de apeluri cu reîncercări și ore de apelare.', refs: ['fg:fg-voice-ai', 'fg:fg-campaigns', 'fg:fg-llms'] },
      { text: 'Evaluare după regulile tale, nu doar după un script. Voice QA notează fiecare apel înregistrat după regulile și ponderile fiecărui departament, cu citate și o sugestie pentru fiecare regulă, și rapoarte în 30 de limbi. CoPilot din Bitrix24 măsoară cât de bine urmează un apel scriptul de vânzări.', refs: ['fg:fg-voice-qa', 'bitrix24:speech'] },
      { text: 'Înregistrări care vin singure de la Moldcell, Orange Moldova sau din aplicația Fineguide de înregistrare a apelurilor pentru Android.', refs: ['fg:fg-llms'] },
      { text: 'Un scop mai restrâns: echipa care lucrează cu clienții primește o singură fișă de client și un singur inbox pentru chat și email, fără să configureze mai întâi un spațiu de lucru al companiei.', refs: ['fg:fg-messages'] },
      { text: 'În română: site-ul Fineguide este în română, engleză și rusă, suportul în română și engleză, iar interfața widgetului de chat există în 24 de limbi.', refs: ['fg:fg-llms'] },
    ],
  },
  choose: {
    heading: 'Pe cine alegi',
    competitor: {
      label: 'Alege Bitrix24 dacă…',
      items: [
        'vrei un singur instrument pentru toată compania: sarcini, proiecte, intranet, HR și CRM;',
        'vrei o ediție on-premise pe care o instalezi singur;',
        'ai nevoie de telefonie cu numere închiriate direct din produs.',
      ],
    },
    fineguide: {
      label: 'Alege Fineguide dacă…',
      items: [
        'echipa ta își petrece ziua în chaturi, emailuri și apeluri cu clienții și vrei ca AI-ul să preia o parte;',
        'evaluezi calitatea apelurilor sau vrei să începi;',
        'derulezi campanii de apeluri;',
        'vrei un furnizor din Chișinău, cu suport în română.',
      ],
    },
  },
  switching: {
    heading: 'Cum treci de la Bitrix24',
    intro: 'Bitrix24 exportă datele din CRM din vizualizarea de tip listă. Atenție la contacte: se exportă doar cele marcate pentru export.',
    steps: [
      { title: 'Începe cu planul Free', body: 'Creează un cont Fineguide (fără card), dă-i unui asistent site-ul și documentele tale și testează-l în widgetul de chat.' },
      { title: 'Exportă din Bitrix24', body: { text: 'Treci CRM-ul pe vizualizarea List și exportă lead-urile, tranzacțiile, contactele și companiile în xls sau csv. Activează opțiunea „Included in export” la contactele pe care le vrei și verifică dacă planul tău permite exportul contactelor.', refs: ['bitrix24:export'] } },
      { title: 'Importă în Fineguide', body: { text: 'Importă fișierele (CSV, TSV, XLS sau XLSX), potrivește coloanele cu câmpurile personalizate și confirmă duplicatele înainte să fie unite.', refs: ['fg:fg-llms'] } },
      { title: 'Reconectează canalele', body: { text: 'Conectează WhatsApp, Telegram, Instagram, Messenger și căsuțele tale de email la inboxul de echipă Fineguide, cu reguli de distribuire și departamente.', refs: ['fg:fg-messages'] } },
      { title: 'Mută apelurile', body: { text: 'Conectează centrala telefonică la Fineguide prin SIP pentru AI pe apeluri sau păstrează centrala actuală și trimite înregistrările în Voice QA.', refs: ['fg:fg-voice-ai', 'fg:fg-voice-qa'] } },
    ],
  },
  faq: [
    {
      q: 'Poate Bitrix24 să evalueze apelurile?',
      a: 'CoPilot transcrie înregistrările și dă fiecărui apel analizat un scor care arată cât de bine se potrivește cu scriptul de vânzări. Voice QA din Fineguide evaluează fiecare apel după regulile și ponderile departamentului care l-a preluat, cu citate și o sugestie pentru fiecare regulă.',
      refs: ['bitrix24:speech', 'fg:fg-voice-qa'],
    },
    {
      q: 'Bitrix24 poate rula on-premise?',
      a: 'Da, Bitrix24 vinde o ediție on-premise pe care o găzduiești pe serverul tău, cu acces la codul sursă. Fineguide oferă instalare on-premise pe infrastructura ta printr-un contract Enterprise.',
      refs: ['bitrix24:plans', 'fg:fg-enterprise'],
    },
    {
      q: 'Ce mesagerii conectează Bitrix24?',
      a: 'Contact Center conectează WhatsApp, chatul live, Bitrix24 Network, Instagram, Facebook, Viber și Telegram. Fineguide conectează widgetul de pe site, WhatsApp, Telegram, Instagram, Messenger, Slack și Discord și lucrează și în amoCRM și Kommo.',
      refs: ['bitrix24:channels', 'fg:fg-assistants'],
    },
    {
      q: 'Cum trec de la Bitrix24 la Fineguide?',
      a: 'Exportă din vizualizarea List a CRM-ului Bitrix24 în xls sau csv (marchează mai întâi contactele pentru export), apoi importă fișierele în CRM-ul Fineguide și confirmă duplicatele înainte să fie unite.',
      refs: ['bitrix24:export', 'fg:fg-llms'],
    },
  ],
  closing: {
    heading: 'Dă-i echipei care lucrează cu clienții propriul AI',
    body: 'Începe cu planul Free, fără card, și vezi cum răspunde un asistent la întrebările tale reale înainte să muți ceva.',
  },
  extraLinks: [{ href: '/ro/campaigns/', label: 'Campanii de apeluri' }],
};
---

<ComparePage lang="ro" slug="bitrix24" copy={copy} />
