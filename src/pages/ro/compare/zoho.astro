---
import ComparePage from '../../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs Zoho CRM: alternativă Zoho CRM cu AI',
  description: 'Alternativă Zoho CRM comparată punct cu punct: Zia AI pe ediții, WhatsApp și mesagerii, apeluri, evaluarea lor și limbi, verificate pe paginile Zoho.',
  crumb: 'Zoho CRM',
  h1: 'Fineguide vs Zoho CRM:',
  h1Accent: 'asistenți AI pe fiecare plan',
  shortAnswer:
    'Zoho CRM este un CRM matur și flexibil, cu 28 de limbi de interfață, inclusiv rusa, și centre de date în nouă regiuni; cea mai mare parte din AI-ul Zia este pe Enterprise și Ultimate. Fineguide este un CRM construit pe AI, în care asistenții de pe orice plan răspund pe chat, email și la telefon, iar Voice QA evaluează apelurile înregistrate. Zoho câștigă la amploare și personalizare; Fineguide la AI conversațional și apeluri.',
  tableHeading: 'Zoho CRM și Fineguide, rând cu rând',
  competitorStronger: {
    heading: 'Unde Zoho CRM este mai puternic',
    items: [
      { text: 'Personalizare și procese: module personalizate, CPQ, portaluri pentru clienți, procese de aprobare, sandbox pentru dezvoltatori și criptare la nivel de câmp.', refs: ['zoho:plans'] },
      { text: 'Limbi: 28 de limbi de interfață, inclusiv rusa.', refs: ['zoho:plans'] },
      { text: 'Centre de date în SUA, Europa, India, Australia, Japonia, Canada, Arabia Saudită, Emiratele Arabe Unite și Singapore.', refs: ['zoho:datacenters'] },
      { text: 'O familie largă de produse și integrări: Bigin, Desk, Campaigns și CRM Plus, plus peste 100 de integrări de telefonie și PBX.', refs: ['zoho:plans', 'zoho:comparison'] },
    ],
  },
  fineguideStronger: {
    heading: 'Unde Fineguide este mai puternic',
    items: [
      { text: 'AI pentru clienți pe fiecare plan. Planurile Fineguide diferă doar prin credite, colegii incluși și spațiul bazei de cunoștințe. Zoho listează agenți AI de la Professional, iar comparația edițiilor bifează predicțiile, AI-ul conversațional și AI-ul pentru email din Zia la Enterprise și Ultimate.', refs: ['fg:fg-llms', 'zoho:plans', 'zoho:comparison'] },
      { text: 'Mesagerie dincolo de WhatsApp, inclusă: Telegram, Instagram, Messenger, Slack, Discord și widgetul de pe site. Zoho CRM integrează singur WhatsApp, iar celelalte mesagerii vin prin aplicații din Marketplace.', refs: ['fg:fg-assistants', 'zoho:whatsapp', 'zoho:marketplace'] },
      { text: 'AI pe apeluri în direct, prin SIP-ul tău, în 14 limbi, și campanii de apeluri derulate de AI.', refs: ['fg:fg-voice-ai', 'fg:fg-campaigns'] },
      { text: 'Evaluarea calității apelurilor: Voice QA transcrie și notează fiecare apel înregistrat după regulile fiecărui departament, cu rapoarte în 30 de limbi.', refs: ['fg:fg-voice-qa'] },
      { text: 'Româna. Cele 28 de limbi de interfață Zoho nu o includ; site-ul Fineguide este în română, engleză și rusă, suportul în română și engleză, iar interfața widgetului de chat include româna și rusa.', refs: ['zoho:plans', 'fg:fg-llms'] },
    ],
  },
  choose: {
    heading: 'Pe cine alegi',
    competitor: {
      label: 'Alege Zoho CRM dacă…',
      items: [
        'ai nevoie de personalizare adâncă: module proprii, portaluri, CPQ și aprobări;',
        'echipa ta lucrează într-una dintre cele 28 de limbi de interfață Zoho;',
        'vrei un centru de date într-o anumită regiune;',
        'folosești deja alte produse Zoho.',
      ],
    },
    fineguide: {
      label: 'Alege Fineguide dacă…',
      items: [
        'vrei ca AI-ul să le răspundă clienților pe fiecare canal, pe orice plan ai începe;',
        'clienții îți scriu pe Telegram, Instagram sau Messenger, nu doar pe WhatsApp;',
        'apelurile contează: AI pe apeluri, campanii sau evaluarea lor;',
        'lucrezi în română.',
      ],
    },
  },
  switching: {
    heading: 'Cum treci de la Zoho CRM',
    intro: 'Zoho exportă fiecare modul într-un fișier tabelar, iar Fineguide citește aceleași formate, așa că mutarea înseamnă mai ales să potrivești câmpurile.',
    steps: [
      { title: 'Începe cu planul Free', body: 'Creează un cont Fineguide (fără card), dă-i unui asistent site-ul și documentele tale și testează-l în widgetul de chat.' },
      { title: 'Exportă din Zoho CRM', body: { text: 'Exportă fiecare modul (lead-uri, contacte, conturi, tranzacții) în CSV sau XLSX.', refs: ['zoho:export'] } },
      { title: 'Importă în Fineguide', body: { text: 'Importă fișierele (CSV, TSV, XLS sau XLSX), potrivește coloanele cu câmpurile personalizate și confirmă duplicatele înainte să fie unite.', refs: ['fg:fg-llms'] } },
      { title: 'Reconectează canalele și emailul', body: { text: 'Conectează WhatsApp, Telegram, Instagram, Messenger și căsuțele tale de email la inboxul de echipă, cu reguli de distribuire și departamente.', refs: ['fg:fg-messages'] } },
      { title: 'Refă fluxurile', body: { text: 'Recreează automatizările în n8n, găzduit de Fineguide sau propriul tău n8n, și dă-le asistenților acțiuni care apelează sistemele tale.', refs: ['fg:fg-llms'] } },
    ],
  },
  faq: [
    {
      q: 'Ce ediție Zoho CRM are Zia AI?',
      a: 'Zoho listează agenți AI de la Professional și AI extins pe Enterprise. În comparația edițiilor, rândurile Zia pentru predicții, AI conversațional și AI pentru email sunt bifate doar la Enterprise și Ultimate, iar unele funcții Zia merg doar în engleză.',
      refs: ['zoho:plans', 'zoho:comparison'],
    },
    {
      q: 'Zoho CRM are interfață în română?',
      a: 'Zoho listează 28 de limbi de interfață, inclusiv rusa, dar nu și româna. Workspace-ul Fineguide este în engleză; site-ul este în română, engleză și rusă, suportul în română și engleză, iar interfața widgetului de chat există în 24 de limbi, inclusiv româna.',
      refs: ['zoho:plans', 'fg:fg-llms'],
    },
    {
      q: 'Zoho CRM se poate conecta la WhatsApp și Telegram?',
      a: 'Zoho CRM are propria integrare WhatsApp; celelalte mesagerii vin prin aplicații din Marketplace. Fineguide conectează direct WhatsApp, Telegram, Instagram, Messenger, Slack și Discord.',
      refs: ['zoho:whatsapp', 'zoho:marketplace', 'fg:fg-assistants'],
    },
    {
      q: 'Cum trec de la Zoho CRM la Fineguide?',
      a: 'Exportă fiecare modul din Zoho CRM în CSV sau XLSX, importă fișierele în CRM-ul Fineguide, potrivește câmpurile și confirmă duplicatele înainte să fie unite.',
      refs: ['zoho:export', 'fg:fg-llms'],
    },
  ],
  closing: {
    heading: 'AI pe fiecare canal, de la primul plan',
    body: 'Începe cu planul Free, fără card, și vezi ce face un asistent cu întrebările reale ale clienților tăi.',
  },
};
---

<ComparePage lang="ro" slug="zoho" copy={copy} />
