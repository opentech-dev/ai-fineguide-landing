---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import EditorialRows from '../../components/EditorialRows.astro';
import RuleList from '../../components/RuleList.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const p = t.campaignsPage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fineguide Campaigns',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: p.meta.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<Layout title={p.meta.title} description={p.meta.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <PageHero eyebrow={p.intro.eyebrow} lang={lang} {...p.hero}>
      <img
        src="/images/photos/voice-desk.jpg"
        alt={p.intro.screenshotAlt}
        width="1376"
        height="768"
        class="w-full h-auto rounded-xl border border-[var(--color-border)] shadow-2xl"
        loading="eager"
      />
    </PageHero>

    <Band tone="dark" eyebrow={p.types.eyebrow} heading={p.types.heading} body={p.types.body}>
      <EditorialRows
        variant="dark"
        columns={3}
        items={p.types.items.map((i) => ({ term: i.name, desc: i.desc }))}
      />
    </Band>

    <Band eyebrow={p.audience.eyebrow} heading={p.audience.heading} body={p.audience.body}>
      <EditorialRows items={p.audience.items} />
    </Band>

    <Band tone="tint" eyebrow={p.telephony.eyebrow} heading={p.telephony.heading} body={p.telephony.body}>
      <RuleList items={p.telephony.bullets} />
    </Band>

    <ClosingCta lang={lang} {...p.finalCta} />
  </main>

  <Footer t={t} lang={lang} />
</Layout>
