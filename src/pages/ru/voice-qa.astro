---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import EditorialRows from '../../components/EditorialRows.astro';
import StepList from '../../components/StepList.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const p = t.voiceQaPage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fineguide Voice QA',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: p.meta.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<Layout title={p.meta.title} description={p.meta.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <PageHero eyebrow={p.intro.eyebrow} lang={lang} {...p.hero}>
      {/* A photograph, not a screenshot: the product shot that used to sit here
          came from a live account and showed billing figures. Replace it with a
          screenshot from the demo workspace when one exists. */}
      <img
        src="/images/photos/call-review.jpg"
        alt={p.intro.screenshotAlt}
        width="1376"
        height="768"
        class="w-full h-auto rounded-xl border border-[var(--color-border)] shadow-2xl"
        loading="eager"
      />
    </PageHero>

    <Band tone="tint" eyebrow={p.process.eyebrow} heading={p.process.heading} body={p.process.body}>
      <StepList steps={p.process.steps} />
    </Band>

    <Band eyebrow={p.sources.eyebrow} heading={p.sources.heading} body={p.sources.body}>
      <EditorialRows items={p.sources.items.map((i) => ({ term: i.name, desc: i.desc }))} />
    </Band>

    <Band tone="dark" eyebrow={p.configuration.eyebrow} heading={p.configuration.heading} body={p.configuration.body}>
      <EditorialRows
        variant="dark"
        items={p.configuration.blocks.map((b) => ({ term: b.title, desc: b.body }))}
      />
    </Band>

    <Band eyebrow={p.callResult.eyebrow} heading={p.callResult.heading} body={p.callResult.body}>
      <EditorialRows items={p.callResult.blocks.map((b) => ({ term: b.title, desc: b.body }))} />
    </Band>

    <Band tone="tint" eyebrow={p.reporting.eyebrow} heading={p.reporting.heading} body={p.reporting.body}>
      <EditorialRows items={p.reporting.blocks.map((b) => ({ term: b.title, desc: b.body }))} />
      <p class="mt-10 max-w-4xl text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
        {p.reporting.footer}
      </p>
    </Band>

    <ClosingCta lang={lang} {...p.finalCta} />
  </main>

  <Footer t={t} lang={lang} />
</Layout>
