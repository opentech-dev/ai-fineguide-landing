---
import ComparePage from '../../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs Odoo: альтернатива Odoo CRM на базе ИИ',
  description: 'Альтернатива Odoo для команд, работающих с клиентами: сравниваем ИИ-агентов, WhatsApp, телефонию, оценку звонков и размещение по страницам Odoo.',
  crumb: 'Odoo',
  h1: 'Fineguide vs Odoo:',
  h1Accent: 'диалог с клиентом — в глубину',
  shortAnswer:
    'Odoo — полный набор бизнес-приложений (CRM, бухгалтерия, склад, HR, eCommerce и многое другое). Fineguide закрывает одну часть этой работы — диалог с клиентом, — но глубже: ИИ-ассистенты в чатах, почте и на живых звонках, CRM с одной карточкой клиента и оценка звонков. Если вам нужна ERP, выбирайте Odoo; если нужен ИИ, который работает с вашими клиентами, — Fineguide.',
  tableHeading: 'Odoo и Fineguide: сравнение по пунктам',
