---
import ComparePage from '../../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs HubSpot: альтернатива HubSpot с ИИ-звонками',
  description: 'Альтернатива HubSpot: сравниваем ИИ-агентов, WhatsApp и мессенджеры, звонки, оценку звонков и языки по официальным страницам HubSpot.',
  crumb: 'HubSpot',
  h1: 'Fineguide vs HubSpot:',
  h1Accent: 'ИИ в чатах, почте и звонках',
