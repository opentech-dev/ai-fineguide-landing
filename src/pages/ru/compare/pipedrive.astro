---
import ComparePage from '../../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs Pipedrive: альтернатива Pipedrive с ИИ-чатом',
  description: 'Альтернатива Pipedrive: сравниваем ИИ-функции, WhatsApp и другие мессенджеры, звонки и оценку звонков по официальным страницам Pipedrive.',
  crumb: 'Pipedrive',
  h1: 'Fineguide vs Pipedrive:',
  h1Accent: 'ИИ, который говорит с вашими клиентами',
  shortAnswer:
    'Pipedrive — сфокусированная и проверенная временем CRM для воронки продаж: более 500 интеграций и ИИ-функции, которые помогают продавцу писать, делать саммари и отчёты. Встроенных звонков в ней нет, а интеграция с WhatsApp пока в бете и доступна на Growth и выше. Fineguide — CRM, построенная вокруг ИИ: её ассистенты отвечают клиентам в чатах, почте и на живых звонках.',
  tableHeading: 'Pipedrive и Fineguide: сравнение по пунктам',
  competitorStronger: {
    heading: 'В чём сильнее Pipedrive',
    items: [
      { text: 'Глубина и проработка воронки: автоматизации и цепочки касаний, отчёты по подпискам и прогнозам, договоры и электронная подпись, собственный скоринг и дополнения для проектов, кампаний, посетителей сайта и документов.', refs: ['pipedrive:plans'] },
      { text: 'Интеграции: более 500 приложений, включая Zapier, Zoom и Lemlist. Собственный список интеграций Fineguide короткий, остальное — через n8n.', refs: ['pipedrive:plans', 'fg:fg-llms'] },
      { text: 'Продажи через почту: полная синхронизация почты с отслеживанием — с Growth, а на Premium и Ultimate — написание писем с ИИ, саммари и предлагаемые ответы.', refs: ['pipedrive:plans', 'pipedrive:ai'] },
      { text: 'Подготовка к встречам: Pipedrive Nova готовит сводку перед встречей, расшифровывает звонки и предлагает обновления в CRM после неё.', refs: ['pipedrive:plans'] },
    ],
  },
  fineguideStronger: {
    heading: 'В чём сильнее Fineguide',
    items: [
      { text: 'Мессенджеры на всех тарифах: чат-виджет на сайте, WhatsApp, Telegram, Instagram, Messenger, Slack и Discord. Интеграция WhatsApp в Pipedrive доступна на Growth и выше, находится в бете и открыта ещё не всем клиентам.', refs: ['fg:fg-llms', 'pipedrive:whatsapp'] },
      { text: 'ИИ, который отвечает клиентам, а не только помогает продавцу. Ассистенты отвечают по вашим материалам, записывают нужные поля в лиды CRM (на платных тарифах) и передают разговор сотруднику. ИИ-функции, которые указывает Pipedrive, помогают продавцу: импорт данных, отчёты, написание и саммари писем.', refs: ['fg:fg-assistants', 'pipedrive:ai'] },
      { text: 'Звонки встроены. Ассистенты принимают и совершают живые звонки через ваш SIP и ведут кампании обзвона, а Voice QA оценивает записанные звонки. Встроенных звонков в Pipedrive нет — он отсылает к приложениям из Marketplace.', refs: ['fg:fg-voice-ai', 'fg:fg-voice-qa', 'pipedrive:calls'] },
      { text: 'Русский и румынский: сайт Fineguide — на английском, румынском и русском, поддержка — на английском и румынском, а интерфейс чат-виджета — на 24 языках, включая русский и румынский.', refs: ['fg:fg-llms'] },
    ],
  },
  choose: {
    heading: 'Кому что выбрать',
    competitor: {
      label: 'Выбирайте Pipedrive, если…',
      items: [
        'ваши продавцы ведут сделки в основном через почту и встречи и хотят простую воронку;',
        'вы опираетесь на приложения из маркетплейса, где более 500 интеграций;',
        'вам нужны электронная подпись, договоры и прогнозы прямо в CRM.',
      ],
    },
    fineguide: {
      label: 'Выбирайте Fineguide, если…',
      items: [
        'клиенты пишут вам в WhatsApp, Telegram, Instagram или на сайте, и вы хотите, чтобы им отвечал ИИ;',
        'звонки важны: входящие, кампании обзвона или оценка качества звонков;',
        'вам нужен румынский на сайте, в поддержке и в чат-виджете.',
      ],
    },
  },
  switching: {
    heading: 'Как перейти с Pipedrive',
    intro: 'Экспорт, импорт, затем каналы: сначала переезжают записи CRM, а ИИ и каналы подключаются, когда вы будете готовы.',
    steps: [
      { title: 'Начните с тарифа Free', body: 'Создайте аккаунт Fineguide (без карты), загрузите в ассистента свой сайт и документы и попробуйте его в чат-виджете.' },
      { title: 'Выгрузите данные из Pipedrive', body: { text: 'Используйте в Pipedrive инструмент Export data и выберите Excel или CSV для каждого типа записей, которые хотите перенести.', refs: ['pipedrive:export'] } },
      { title: 'Импортируйте в Fineguide', body: { text: 'Загрузите файлы (CSV, TSV, XLS или XLSX), сопоставьте колонки с вашими полями и проверьте дубли до любого объединения.', refs: ['fg:fg-llms'] } },
      { title: 'Перенесите почту и каналы', body: { text: 'Подключите свои почтовые ящики по IMAP и SMTP, затем WhatsApp, Telegram, Instagram или Messenger, с правилами распределения и отделами.', refs: ['fg:fg-messages'] } },
      { title: 'Добавьте звонки, когда понадобятся', body: { text: 'Подключите телефонию по SIP, чтобы ИИ работал на звонках, или отправляйте записи в Voice QA на оценку.', refs: ['fg:fg-voice-ai', 'fg:fg-voice-qa'] } },
    ],
  },
  faq: [
    {
      q: 'Может ли Pipedrive звонить?',
      a: 'В базе знаний Pipedrive сказано, что встроенной интеграции звонков нет; звонки идут через приложения из Marketplace, например CloudTalk или Aircall, или через мобильные приложения Pipedrive. ИИ-ассистенты Fineguide принимают и совершают звонки через вашу SIP-телефонию.',
      refs: ['pipedrive:calls', 'fg:fg-voice-ai'],
    },
    {
      q: 'Работает ли Pipedrive с WhatsApp?',
      a: 'Да, на Growth и выше, как бета-функция, которая, по словам Pipedrive, доступна ещё не всем клиентам. В Fineguide WhatsApp — канал на всех тарифах, и в нём отвечают те же ассистенты, что и в других каналах.',
      refs: ['pipedrive:whatsapp', 'fg:fg-llms'],
    },
    {
      q: 'В каких тарифах Pipedrive есть ИИ?',
      a: 'ИИ-помощник импорта, создание отчётов с ИИ и Sales Assistant есть на всех тарифах; написание писем с ИИ, саммари и предлагаемые ответы — на Premium и Ultimate. Каждый тариф Fineguide включает ИИ-ассистентов.',
      refs: ['pipedrive:ai', 'fg:fg-pricing'],
    },
    {
      q: 'Подходит ли Fineguide как альтернатива Pipedrive для колл-центра?',
      a: 'Fineguide создан для такой работы: ИИ на живых звонках, кампании обзвона и Voice QA, который оценивает каждый записанный звонок по правилам конкретного отдела и приводит цитаты, на которых основана каждая оценка. Сильная сторона Pipedrive — управление сделками для отделов продаж.',
      refs: ['fg:fg-voice-ai', 'fg:fg-campaigns', 'fg:fg-voice-qa'],
    },
    {
      q: 'Как перенести данные из Pipedrive в Fineguide?',
      a: 'Выгрузите данные из Pipedrive в Excel или CSV, импортируйте их в CRM Fineguide (CSV, TSV, XLS или XLSX), сопоставьте свои поля и подтвердите дубли перед объединением.',
      refs: ['pipedrive:export', 'fg:fg-llms'],
    },
  ],
  closing: {
    heading: 'Пусть первый разговор возьмёт на себя ИИ',
    body: 'Начните с тарифа Free без карты и посмотрите, как ассистент отвечает вашим клиентам, ещё до того, как вы перенесёте хотя бы одну сделку.',
  },
};
---

<ComparePage lang="ru" slug="pipedrive" copy={copy} />
