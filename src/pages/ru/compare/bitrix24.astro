      items: [
        'вам нужен один инструмент для всей компании: задачи, проекты, интранет, HR и CRM;',
        'вам нужна коробочная версия, которую вы установите сами;',
        'нужна телефония с номерами, арендованными прямо в продукте.',
      ],
    },
    fineguide: {
      label: 'Выбирайте Fineguide, если…',
      items: [
        'ваша команда весь день ведёт чаты, переписку и звонки с клиентами, и вы хотите, чтобы ИИ взял на себя свою часть;',
        'вы оцениваете качество звонков или хотите начать;',
        'вы ведёте кампании обзвона;',
        'вам нужен поставщик из Кишинёва с поддержкой на румынском.',
      ],
    },
  },
  switching: {
    heading: 'Как перейти с Битрикс24',
