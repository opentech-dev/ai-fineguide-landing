---
import ComparePage from '../../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs Битрикс24: альтернатива Битрикс24 с ИИ',
  description: 'Альтернатива Битрикс24: сравниваем ИИ, каналы контакт-центра, телефонию, оценку звонков и коробочную версию по официальным страницам Bitrix24.',
  crumb: 'Битрикс24',
  h1: 'Fineguide vs Битрикс24:',
  h1Accent: 'CRM, построенная вокруг диалога',
  shortAnswer:
    'Битрикс24 — широкая рабочая платформа (CRM, задачи, проекты, сайты, HR и телефония) с коробочной версией. Fineguide — продукт более узкий: это CRM, построенная вокруг ИИ, где ассистенты отвечают в чатах, почте и на живых звонках из одной карточки клиента и где каждый записанный звонок можно оценить. Выбирайте Битрикс24 как общую платформу для всей компании; выбирайте Fineguide, когда ваша работа — это диалоги и звонки с клиентами.',
  tableHeading: 'Битрикс24 и Fineguide: сравнение по пунктам',
  competitorStronger: {
    heading: 'В чём сильнее Битрикс24',
