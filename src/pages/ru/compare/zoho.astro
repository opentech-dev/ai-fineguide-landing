---
import ComparePage from '../../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs Zoho CRM: альтернатива Zoho CRM с ИИ',
  description: 'Альтернатива Zoho CRM: сравниваем ИИ Zia по редакциям, WhatsApp и мессенджеры, звонки, оценку звонков и языки по официальным страницам Zoho.',
  crumb: 'Zoho CRM',
  h1: 'Fineguide vs Zoho CRM:',
  h1Accent: 'ИИ-ассистенты на каждом тарифе',
  shortAnswer:
    'Zoho CRM — зрелая и гибкая CRM: 28 языков интерфейса, включая русский, и дата-центры в девяти регионах; большая часть ИИ Zia — в редакциях Enterprise и Ultimate. Fineguide — CRM, построенная вокруг ИИ: ассистенты на любом тарифе отвечают в чатах, почте и на живых звонках, а Voice QA оценивает записанные звонки. Zoho выигрывает широтой и гибкостью настройки; Fineguide — разговорным ИИ и звонками.',
  tableHeading: 'Zoho CRM и Fineguide: сравнение по пунктам',
  competitorStronger: {
    heading: 'В чём сильнее Zoho CRM',
    items: [
      { text: 'Кастомизация и процессы: собственные модули, CPQ, клиентские порталы, процессы согласования, песочница для разработчиков и шифрование на уровне полей.', refs: ['zoho:plans'] },
      { text: 'Языки: 28 языков интерфейса, включая русский.', refs: ['zoho:plans'] },
      { text: 'Дата-центры в США, Европе, Индии, Австралии, Японии, Канаде, Саудовской Аравии, ОАЭ и Сингапуре.', refs: ['zoho:datacenters'] },
      { text: 'Большое семейство продуктов и интеграций: Bigin, Desk, Campaigns и CRM Plus, а также более 100 интеграций с телефонией и АТС.', refs: ['zoho:plans', 'zoho:comparison'] },
    ],
  },
  fineguideStronger: {
    heading: 'В чём сильнее Fineguide',
    items: [
      { text: 'ИИ для клиентов на каждом тарифе. Тарифы Fineguide различаются только кредитами, числом включённых коллег и объёмом базы знаний. Zoho указывает ИИ-агентов с Professional, а в сравнении редакций прогнозы Zia, разговорный ИИ и ИИ для почты отмечены для Enterprise и Ultimate.', refs: ['fg:fg-llms', 'zoho:plans', 'zoho:comparison'] },
      { text: 'Не только WhatsApp, и всё встроено: Telegram, Instagram, Messenger, Slack, Discord и чат-виджет на сайте. Zoho CRM сама интегрируется с WhatsApp, а другие мессенджеры подключаются через приложения из Marketplace.', refs: ['fg:fg-assistants', 'zoho:whatsapp', 'zoho:marketplace'] },
      { text: 'ИИ на живых звонках через ваш SIP на 14 языках и исходящие кампании обзвона с ИИ.', refs: ['fg:fg-voice-ai', 'fg:fg-campaigns'] },
      { text: 'Оценка качества звонков: Voice QA расшифровывает и оценивает каждый записанный звонок по правилам конкретного отдела, с отчётами на 30 языках.', refs: ['fg:fg-voice-qa'] },
      { text: 'Румынский. Среди 28 языков интерфейса Zoho его нет; сайт Fineguide — на английском, румынском и русском, поддержка — на английском и румынском, а интерфейс чат-виджета поддерживает румынский и русский.', refs: ['zoho:plans', 'fg:fg-llms'] },
    ],
  },
  choose: {
    heading: 'Кому что выбрать',
    competitor: {
      label: 'Выбирайте Zoho CRM, если…',
      items: [
        'вам нужна глубокая кастомизация: собственные модули, порталы, CPQ и согласования;',
        'команда работает на одном из 28 языков интерфейса Zoho;',
        'вам нужен дата-центр в определённом регионе;',
        'вы уже пользуетесь другими продуктами Zoho.',
      ],
    },
    fineguide: {
      label: 'Выбирайте Fineguide, если…',
      items: [
        'вы хотите, чтобы ИИ отвечал клиентам во всех каналах, на каком бы тарифе вы ни начали;',
        'клиенты пишут вам в Telegram, Instagram или Messenger, а не только в WhatsApp;',
        'звонки важны: ИИ на звонках, кампании обзвона или оценка звонков;',
        'вы работаете на румынском.',
      ],
    },
  },
  switching: {
    heading: 'Как перейти с Zoho CRM',
    intro: 'Zoho выгружает каждый модуль в таблицу, а Fineguide читает те же форматы, так что переезд сводится в основном к сопоставлению полей.',
    steps: [
      { title: 'Начните с тарифа Free', body: 'Создайте аккаунт Fineguide (без карты), загрузите в ассистента свой сайт и документы и проверьте его в чат-виджете.' },
      { title: 'Выгрузите данные из Zoho CRM', body: { text: 'Выгрузите каждый модуль (лиды, контакты, аккаунты, сделки) в CSV или XLSX.', refs: ['zoho:export'] } },
      { title: 'Импортируйте в Fineguide', body: { text: 'Загрузите файлы (CSV, TSV, XLS или XLSX), сопоставьте колонки с вашими полями и подтвердите дубли перед объединением.', refs: ['fg:fg-llms'] } },
      { title: 'Подключите каналы и почту', body: { text: 'Подключите WhatsApp, Telegram, Instagram, Messenger и свои почтовые ящики к общему ящику входящих, с правилами распределения и отделами.', refs: ['fg:fg-messages'] } },
      { title: 'Перенесите сценарии', body: { text: 'Воссоздайте автоматизации в n8n — размещённом у Fineguide или в вашем собственном экземпляре — и дайте ассистентам действия, которые обращаются к вашим системам.', refs: ['fg:fg-llms'] } },
    ],
  },
  faq: [
    {
      q: 'В какой редакции Zoho CRM есть ИИ Zia?',
      a: 'Zoho указывает ИИ-агентов с Professional и расширенный ИИ на Enterprise. В сравнении редакций строки Zia (прогнозы, разговорный ИИ и ИИ для почты) отмечены только для Enterprise и Ultimate, а часть функций Zia работает только на английском.',
      refs: ['zoho:plans', 'zoho:comparison'],
    },
    {
      q: 'Поддерживает ли Zoho CRM румынский?',
      a: 'Zoho указывает 28 языков интерфейса, включая русский, но не румынский. Рабочее пространство Fineguide — на английском; сайт — на английском, румынском и русском, поддержка — на английском и румынском, а интерфейс чат-виджета — на 24 языках, включая румынский.',
      refs: ['zoho:plans', 'fg:fg-llms'],
    },
    {
      q: 'Можно ли подключить к Zoho CRM WhatsApp и Telegram?',
      a: 'У Zoho CRM есть собственная интеграция с WhatsApp; другие мессенджеры подключаются через приложения из Marketplace. Fineguide подключает WhatsApp, Telegram, Instagram, Messenger, Slack и Discord напрямую.',
      refs: ['zoho:whatsapp', 'zoho:marketplace', 'fg:fg-assistants'],
    },
    {
      q: 'Как перейти с Zoho CRM на Fineguide?',
      a: 'Выгрузите каждый модуль из Zoho CRM в CSV или XLSX, импортируйте файлы в CRM Fineguide, сопоставьте поля и подтвердите дубли перед объединением.',
      refs: ['zoho:export', 'fg:fg-llms'],
    },
  ],
  closing: {
    heading: 'ИИ во всех каналах с первого тарифа',
    body: 'Начните с тарифа Free без карты и посмотрите, что ассистент сделает с вопросами ваших клиентов.',
  },
};
---

<ComparePage lang="ru" slug="zoho" copy={copy} />
