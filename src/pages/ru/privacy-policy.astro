---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PrivacyPolicy from '../../components/legal/PrivacyPolicy.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<Layout
  title="Политика конфиденциальности | Fineguide.ai"
  description="Как Fineguide.ai обрабатывает персональные данные по молдавскому Закону № 195/2024: что собираем, зачем, кому передаём, сколько храним и какие у вас права."
  lang={lang}
>
  <Navbar t={t} lang={lang} />

  <main id="main-content">

  <PrivacyPolicy lang={lang} />

  </main>

  <Footer t={t} lang={lang} />
</Layout>
