---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import EditorialRows from '../components/EditorialRows.astro';
import RuleList from '../components/RuleList.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const p = t.crmPage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fineguide CRM',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: p.meta.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<Layout title={p.meta.title} description={p.meta.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <PageHero eyebrow={p.intro.eyebrow} lang={lang} {...p.hero}>
      {/* The screenshot here came from a live account and showed internal data.
          Until one is captured from demo data, the intro sits in its place. */}
      <p class="text-2xl md:text-3xl leading-relaxed text-[var(--color-muted)] font-light text-pretty">
        {p.intro.body}
      </p>
    </PageHero>

    <Band tone="dark" eyebrow={p.surfaces.eyebrow} heading={p.surfaces.heading} body={p.surfaces.body}>
      <EditorialRows variant="dark" items={p.surfaces.items.map((i) => ({ term: i.name, desc: i.desc }))} />
    </Band>

    <Band tone="tint" eyebrow={p.customerRecord.eyebrow} heading={p.customerRecord.heading} body={p.customerRecord.body}>
      <RuleList items={p.customerRecord.bullets} />
    </Band>

    <ClosingCta lang={lang} {...p.finalCta} />
  </main>

  <Footer t={t} lang={lang} />
</Layout>
