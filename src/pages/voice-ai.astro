---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import EditorialRows from '../components/EditorialRows.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const p = t.voiceAiPage;
---

<Layout title={p.meta.title} description={p.meta.description} lang={lang}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <PageHero eyebrow={p.intro.eyebrow} lang={lang} {...p.hero}>
      <p class="text-2xl md:text-3xl leading-relaxed text-[var(--color-muted)] font-light text-pretty">
        {p.intro.body}
      </p>
    </PageHero>

    <Band tone="dark" eyebrow={p.capabilities.eyebrow} heading={p.capabilities.heading} body={p.capabilities.body}>
      <EditorialRows
        variant="dark"
        items={p.capabilities.blocks.map((b) => ({ term: b.title, desc: b.body }))}
      />
    </Band>

    <ClosingCta lang={lang} {...p.finalCta} />
  </main>

  <Footer t={t} lang={lang} />
</Layout>
