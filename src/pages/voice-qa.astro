---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import EditorialRows from '../components/EditorialRows.astro';
import StepList from '../components/StepList.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const p = t.voiceQaPage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fineguide Voice QA',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: p.meta.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<Layout title={p.meta.title} description={p.meta.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <PageHero eyebrow={p.intro.eyebrow} lang={lang} {...p.hero}>
      {/* The screenshot here came from a live account and showed internal data.
          Until one is captured from demo data, the intro sits in its place. */}
      <p class="text-2xl md:text-3xl leading-relaxed text-[var(--color-muted)] font-light text-pretty">
        {p.intro.body}
      </p>
    </PageHero>

    <Band tone="tint" eyebrow={p.process.eyebrow} heading={p.process.heading} body={p.process.body}>
      <StepList steps={p.process.steps} />
    </Band>

    <Band tone="dark" eyebrow={p.configuration.eyebrow} heading={p.configuration.heading} body={p.configuration.body}>
      <EditorialRows
        variant="dark"
        items={p.configuration.blocks.map((b) => ({ term: b.title, desc: b.body }))}
      />
    </Band>

    <Band eyebrow={p.extraction.eyebrow} heading={p.extraction.heading} body={p.extraction.body}>
      <EditorialRows items={p.extraction.blocks.map((b) => ({ term: b.title, desc: b.body }))} />
      <p class="mt-10 max-w-4xl text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
        {p.extraction.footer}
      </p>
    </Band>

    <ClosingCta lang={lang} rule {...p.finalCta} />
  </main>

  <Footer t={t} lang={lang} />
</Layout>
