---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PricingExplainer from '../components/PricingExplainer.astro';
import PricingPlans from '../components/PricingPlans.astro';
import PricingRunOut from '../components/PricingRunOut.astro';
import PricingAddons from '../components/PricingAddons.astro';
import PricingCredits from '../components/PricingCredits.astro';
import PricingEnterprise from '../components/PricingEnterprise.astro';
import PricingFaq from '../components/PricingFaq.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<Layout title={t.pricingMeta.title} description={t.pricingMeta.description} lang={lang}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">

  <!-- Hero -->
  <section class="pt-32 md:pt-40 pb-16 md:pb-20 px-6">
    <div class="max-w-7xl mx-auto">
      <h1 class="max-w-4xl text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.05] text-balance" set:html={t.pricingPage.heading} />
      <p class="mt-6 max-w-2xl text-lg md:text-xl leading-relaxed text-[var(--color-muted)]">
        {t.pricingPage.subtitle}
      </p>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-[var(--color-muted)]">
        {t.pricingPage.bullets.map((bullet: string) => (
          <li class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            {bullet}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PricingExplainer t={t} />

  <PricingPlans t={t} />
  <PricingRunOut t={t} />
  <PricingAddons t={t} />
  <PricingCredits t={t} />
  <PricingEnterprise t={t} lang={lang} />
  <PricingFaq t={t} />
  </main>

  <Footer t={t} lang={lang} />
</Layout>
