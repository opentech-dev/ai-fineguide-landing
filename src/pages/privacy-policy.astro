---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PrivacyPolicy from '../components/legal/PrivacyPolicy.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<Layout
  title="Privacy Policy | Fineguide.ai"
  description="How Fineguide.ai handles personal data under Moldova’s Law 195/2024: what we collect, why, who receives it, how long we keep it and your rights."
  lang={lang}
>
  <Navbar t={t} lang={lang} />

  <main id="main-content">

  <PrivacyPolicy lang={lang} />

  </main>

  <Footer t={t} lang={lang} />
</Layout>

