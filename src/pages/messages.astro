---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EditorialRows from '../components/EditorialRows.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const p = t.messagesPage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fineguide Messages & Inbox',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: p.meta.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<Layout title={p.meta.title} description={p.meta.description} lang={lang} jsonLd={jsonLd}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <section class="pt-36 pb-12 md:pt-44 md:pb-20 overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <div class="w-full lg:w-[42%] flex-shrink-0">
          <p class="eyebrow mb-5">{p.intro.eyebrow}</p>
          <h1
            class="font-[var(--font-display)] text-[clamp(2.25rem,9vw,3rem)] sm:text-6xl md:text-7xl font-semibold tracking-tight leading-[1.02] text-[var(--color-foreground)]"
          >
            {p.hero.title}
            <span class="text-[var(--color-primary)]">{p.hero.titleAccent}</span>
          </h1>
          <p class="mt-8 max-w-2xl text-xl md:text-2xl text-[var(--color-muted)] leading-relaxed">
            {p.hero.subtitle}
          </p>
          <div class="mt-12 flex flex-col sm:flex-row gap-4">
            <a
              href="https://app.fineguide.ai/register"
              class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all"
            >
              {p.hero.ctaPrimary}
            </a>
            <a
              href={getLocalizedPath('/schedule-demo', lang)}
              class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-[var(--color-foreground)] border border-[var(--color-border)] hover:border-[var(--color-foreground)] rounded-lg transition-all"
            >
              {p.hero.ctaSecondary}
            </a>
          </div>
        </div>
        <div class="lg:w-[58%]">
          <img
            src="/images/photos/channels-phone.jpg"
            alt={p.intro.screenshotAlt}
            width="1376"
            height="768"
            class="h-auto rounded-xl border border-[var(--color-border)] shadow-2xl relative w-full"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="py-24 md:py-32 px-6 bg-[#0f1117] text-white dark-grain">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow-light mb-5">{p.channels.eyebrow}</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight">
          {p.channels.heading}
        </h2>
        <p class="mt-6 max-w-5xl text-lg md:text-xl text-gray-300 leading-relaxed">
          {p.channels.body}
        </p>
        <EditorialRows
          class="mt-14"
          variant="dark"
          items={p.channels.items.map((i) => ({ term: i.name, desc: i.desc }))}
        />
      </div>
    </section>

    <section class="py-20 md:py-28 px-6">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{p.handover.eyebrow}</p>
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]"
        >
          {p.handover.heading}
        </h2>
        <p class="mt-6 max-w-4xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {p.handover.body}
        </p>
        <EditorialRows class="mt-12" items={p.handover.items} />
      </div>
    </section>

    <section class="band-tint py-20 md:py-28 px-6">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{p.email.eyebrow}</p>
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]"
        >
          {p.email.heading}
        </h2>
        <p class="mt-6 max-w-4xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {p.email.body}
        </p>
        <ul class="mt-12 space-y-5">
          {
            p.email.bullets.map((b) => (
              <li class="flex gap-4 border-t border-[var(--color-border)] pt-5">
                <span class="text-[var(--color-accent)] mt-1 shrink-0">—</span>
                <span class="text-lg text-[var(--color-foreground)] leading-relaxed">{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="py-20 md:py-28 px-6">
      <div class="max-w-7xl mx-auto">
        <p class="eyebrow mb-5">{p.safety.eyebrow}</p>
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]"
        >
          {p.safety.heading}
        </h2>
        <p class="mt-6 max-w-4xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {p.safety.body}
        </p>
        <EditorialRows class="mt-12" items={p.safety.items} />
      </div>
    </section>

    <section class="py-24 md:py-36 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]"
        >
          {p.finalCta.heading}
        </h2>
        <p class="mt-6 text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {p.finalCta.body}
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://app.fineguide.ai/register"
            class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all"
          >
            {p.finalCta.ctaPrimary}
          </a>
          <a
            href={getLocalizedPath('/schedule-demo', lang)}
            class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-[var(--color-foreground)] border border-[var(--color-border)] hover:border-[var(--color-foreground)] rounded-lg transition-all"
          >
            {p.finalCta.ctaSecondary}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} lang={lang} />
</Layout>
