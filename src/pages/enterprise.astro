---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const e = t.enterprisePage;
---

<Layout title={t.enterpriseMeta.title} description={t.enterpriseMeta.description} lang={lang}>
  <Navbar t={t} lang={lang} />

  <main id="main-content">
    <!-- Hero -->
    <section class="pt-36 pb-20 md:pt-44 md:pb-28 px-6">
      <div class="max-w-7xl mx-auto">
        <h1 class="font-[var(--font-display)] text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-semibold tracking-tight leading-[1.02] text-[var(--color-foreground)]">
          {e.hero.title}
          <span class="text-[var(--color-primary)]">{e.hero.titleAccent}</span>
        </h1>
        <p class="mt-8 max-w-5xl text-xl md:text-2xl text-[var(--color-muted)] leading-relaxed">
          {e.hero.subtitle}
        </p>
        <div class="mt-12">
          <a
            href={`mailto:${e.contactBlock.email}`}
            class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all"
          >
            {e.hero.cta}
          </a>
        </div>
      </div>
    </section>

    <!-- Dedicated service -->
    <section class="py-20 md:py-28 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-primary)] mb-5">
          {e.service.eyebrow}
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
          {e.service.heading}
        </h2>
        <p class="mt-6 max-w-5xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {e.service.body}
        </p>
        <ul class="mt-12 space-y-5 max-w-3xl">
          {e.service.items.map((item) => (
            <li class="flex gap-4 text-lg text-[var(--color-foreground)] border-t border-[var(--color-border)]/60 pt-5">
              <span class="text-[var(--color-primary)] mt-1">—</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- On-premise (dark editorial break) -->
    <section class="py-24 md:py-32 px-6 bg-[#0f1117] text-white dark-grain">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm font-medium uppercase tracking-widest text-[#c7b8ff] mb-5">
          {e.onPremise.eyebrow}
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight">
          {e.onPremise.heading}
        </h2>
        <p class="mt-6 max-w-5xl text-lg md:text-xl text-gray-300 leading-relaxed">
          {e.onPremise.body}
        </p>
        <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
          {e.onPremise.items.map((item) => (
            <div class="border-t border-white/10 pt-5">
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-white">
                {item.title}
              </h3>
              <p class="mt-3 text-base text-gray-300 leading-relaxed">
                {item.body}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Adaptation -->
    <section class="py-20 md:py-28 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-primary)] mb-5">
          {e.adaptation.eyebrow}
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
          {e.adaptation.heading}
        </h2>
        <p class="mt-6 max-w-5xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {e.adaptation.body}
        </p>
        <ul class="mt-12 space-y-5 max-w-3xl">
          {e.adaptation.items.map((item) => (
            <li class="flex gap-4 text-lg text-[var(--color-foreground)] border-t border-[var(--color-border)]/60 pt-5">
              <span class="text-[var(--color-primary)] mt-1">—</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Consultancy -->
    <section class="py-20 md:py-28 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-primary)] mb-5">
          {e.consultancy.eyebrow}
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
          {e.consultancy.heading}
        </h2>
        <p class="mt-6 max-w-5xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {e.consultancy.body}
        </p>
        <ul class="mt-12 space-y-5 max-w-3xl">
          {e.consultancy.items.map((item) => (
            <li class="flex gap-4 text-lg text-[var(--color-foreground)] border-t border-[var(--color-border)]/60 pt-5">
              <span class="text-[var(--color-primary)] mt-1">—</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Plans -->
    <section class="py-20 md:py-28 px-6 border-t border-[var(--color-border)]/60">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-primary)] mb-5">
          {e.plans.eyebrow}
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
          {e.plans.heading}
        </h2>
        <p class="mt-6 max-w-5xl text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
          {e.plans.body}
        </p>
        <ul class="mt-12 space-y-5 max-w-3xl">
          {e.plans.items.map((item) => (
            <li class="flex gap-4 text-lg text-[var(--color-foreground)] border-t border-[var(--color-border)]/60 pt-5">
              <span class="text-[var(--color-primary)] mt-1">—</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contact block (dark) -->
    <section class="py-24 md:py-32 px-6 bg-[#0f1117] text-white dark-grain">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight">
          {e.contactBlock.heading}
        </h2>
        <p class="mt-6 text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl">
          {e.contactBlock.subtitle}
        </p>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-y-10 gap-x-12 max-w-3xl">
          <div>
            <p class="text-sm uppercase tracking-widest text-[#c7b8ff] mb-3">
              {e.contactBlock.emailLabel}
            </p>
            <a
              href={`mailto:${e.contactBlock.email}`}
              class="text-xl md:text-2xl text-white hover:text-[#c7b8ff] transition-colors"
            >
              {e.contactBlock.email}
            </a>
          </div>
          <div>
            <p class="text-sm uppercase tracking-widest text-[#c7b8ff] mb-3">
              {e.contactBlock.phoneLabel}
            </p>
            <a
              href={getLocalizedPath('/contact', lang)}
              class="text-xl md:text-2xl text-white hover:text-[#c7b8ff] transition-colors underline decoration-white/30 underline-offset-4"
            >
              {t.contact.responseNote}
            </a>
          </div>
        </div>

        <div class="mt-14">
          <a
            href={getLocalizedPath('/schedule-demo', lang)}
            class="inline-flex items-center gap-1.5 text-base font-semibold text-[#c7b8ff] hover:underline"
          >
            {e.contactBlock.ctaLabel}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 md:py-32 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight leading-tight text-[var(--color-foreground)]">
          {e.finalCta.heading}
        </h2>
        <p class="mt-5 text-lg text-[var(--color-muted)] leading-relaxed">
          {e.finalCta.subtitle}
        </p>
        <div class="mt-10">
          <a
            href={`mailto:${e.contactBlock.email}`}
            class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[var(--color-primary)] hover:opacity-90 rounded-lg transition-all"
          >
            {e.finalCta.ctaLabel}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} lang={lang} />
</Layout>
