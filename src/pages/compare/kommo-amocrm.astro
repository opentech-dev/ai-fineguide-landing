---
import ComparePage from '../../components/compare/ComparePage.astro';
import type { CompareCopy } from '../../components/compare/types';

const copy: CompareCopy = {
  title: 'Fineguide vs Kommo and amoCRM: an AI-first alternative',
  description: 'A Kommo and amoCRM alternative, compared fact by fact: AI agents, messaging channels, phone calls, call scoring and languages, checked on vendor pages.',
  crumb: 'Kommo and amoCRM',
  h1: 'Fineguide vs Kommo and amoCRM:',
  h1Accent: 'an AI-first alternative',
  shortAnswer:
    'Kommo (called amoCRM until October 2022) and amoCRM are mature, messenger-first sales CRMs. Fineguide is an AI-first CRM whose AI assistants also take live phone calls and score recorded ones. If your team already runs Kommo or amoCRM, you can add Fineguide’s assistants inside it instead of switching.',
  tableHeading: 'Kommo vs amoCRM vs Fineguide at a glance',
  competitorStronger: {
    heading: 'Where Kommo and amoCRM are stronger',
    items: [
      {
        text: 'Maturity and ecosystem. Both sites carry a copyright line that runs from 2009 (Kommo is the name amoCRM’s international product took in October 2022), and Kommo’s FAQ counts more than 100 integrations on its marketplace. Fineguide’s own list of native integrations is shorter (Zendesk, HelpScout, Google Calendar, Facebook Lead Ads, amoCRM and Kommo); everything else goes through n8n.',
        refs: ['kommo:plans', 'amocrm:plans', 'kommo:rebrand', 'fg:fg-llms'],
      },
      {
        text: 'Messenger reach. Kommo connects TikTok as well as WhatsApp, Instagram, Messenger and Telegram, and its Pro plan allows unlimited channels and up to 50 AI agents. Fineguide does not list TikTok.',
        refs: ['kommo:plans'],
      },
      {
        text: 'Sales tools built up over years: Kommo’s no-code bots, broadcasting, booking pages and audience sync to ad platforms; amoCRM’s Salesbot builder, Digital Pipeline automation, web forms and an NPS score.',
        refs: ['kommo:plans', 'amocrm:plans'],
      },
      {
        text: 'Implementation partners. amoCRM’s site offers turnkey implementation through partners, and Kommo lists official partners and an expert-partner service.',
        refs: ['amocrm:plans', 'kommo:plans'],
      },
    ],
  },
  fineguideStronger: {
    heading: 'Where Fineguide is stronger',
    items: [
      {
        text: 'AI on the phone. The same assistants that answer chats take live inbound and outbound calls over your own phone system (SIP), in 14 languages including Romanian and Russian, and run outbound call campaigns. Kommo’s AI agent answers messages and, on Pro, voice notes; none of the Kommo or amoCRM pages we checked lists AI on live calls.',
        refs: ['fg:fg-voice-ai', 'fg:fg-campaigns', 'kommo:ai-agent', 'kommo:plans', 'amocrm:plans'],
      },
      {
        text: 'Call-quality scoring built in. Voice QA transcribes every recorded call and scores it against each department’s rules, with reports in 30 languages, and can push the results into amoCRM or Kommo.',
        refs: ['fg:fg-voice-qa', 'fg:fg-llms'],
      },
      {
        text: 'No API key to bring. Fineguide’s assistants run on the credits included in every plan. amoCRM’s AI agent needs your own OpenAI or YandexGPT key and starts on the Профессиональный plan.',
        refs: ['fg:fg-pricing', 'amocrm:ai-agent'],
      },
      {
        text: 'Romanian, and a team in Chișinău. Fineguide’s site is in English, Romanian and Russian, its support in English and Romanian, and its chat widget interface comes in 24 languages, including Romanian and Russian. Kommo’s interface languages do not include Romanian.',
        refs: ['fg:fg-llms', 'kommo:languages'],
      },
    ],
  },
  choose: {
    heading: 'Who should choose which',
    competitor: {
      label: 'Choose Kommo or amoCRM if…',
      items: [
        'your sales already run in Kommo or amoCRM, with bots, pipelines and integrations the team depends on (you can still add Fineguide inside it);',
        'you sell mainly through messengers, TikTok included, and want up to 50 AI agents on one plan;',
        'you need a ready-made marketplace integration that Fineguide reaches only through n8n.',
      ],
    },
    fineguide: {
      label: 'Choose Fineguide if…',
      items: [
        'you want AI that answers chat, email and phone calls from one customer record;',
        'you score call quality or run outbound call campaigns;',
        'you work in Romanian, or in Moldova, and want a vendor based in Chișinău with support in Romanian.',
      ],
    },
  },
  switching: {
    heading: 'Switching from Kommo or amoCRM',
    intro:
      'You do not have to move everything on day one. Many teams start by putting a Fineguide assistant inside the Kommo or amoCRM they already use, then move the CRM itself when they are ready.',
    steps: [
      {
        title: 'Start on the Free plan',
        body: 'Create a Fineguide account (no card needed), add your knowledge to an assistant (website URLs, documents, PDFs) and test it in the website chat widget.',
      },
      {
        title: 'Run it inside Kommo or amoCRM',
        body: { text: 'Connect the amoCRM or Kommo integration so the assistant answers your customers there, and send Voice QA call scores back to the same CRM.', refs: ['fg:fg-llms'] },
      },
      {
        title: 'Export your data',
        body: {
          text: 'From Kommo, export leads, contacts and companies as .xlsx or .csv. From amoCRM, filter the deal list by all stages before you export, so closed deals come too.',
          refs: ['kommo:export', 'amocrm:export'],
        },
      },
      {
        title: 'Import into Fineguide',
        body: { text: 'Import the file (CSV, TSV, XLS or XLSX) into the Fineguide CRM, map the columns to your custom fields, and review duplicates: a person confirms every merge.', refs: ['fg:fg-llms'] },
      },
      {
        title: 'Move channels and calls',
        body: 'Connect WhatsApp, Telegram, Instagram or Messenger directly to Fineguide, add your own mailboxes, and connect your phone system over SIP if you want AI on calls.',
      },
    ],
  },
  faq: [
    {
      q: 'Is Fineguide a Kommo alternative or an add-on?',
      a: 'Both. Fineguide is a full CRM with its own team inbox, so it can replace Kommo or amoCRM. Its AI assistants also work inside amoCRM and Kommo, and Voice QA can push call scores to them, so you can keep your CRM and add Fineguide.',
      refs: ['fg:fg-llms'],
    },
    {
      q: 'Does Kommo or amoCRM have a Romanian interface?',
      a: 'Kommo’s help centre lists English, Indonesian, Portuguese (Brazil), Russian, Spanish (Latin America) and Turkish, so no. amoCRM’s site and help centre are in Russian. Fineguide’s workspace is in English, its site is in English, Romanian and Russian, its support in English and Romanian, and its chat widget interface comes in 24 languages, Romanian included.',
      refs: ['kommo:languages', 'amocrm:plans', 'fg:fg-llms'],
    },
    {
      q: 'Do I need my own OpenAI key?',
      a: 'For amoCRM’s AI agent, yes: its help page has you choose OpenAI or YandexGPT and enter your API key. Kommo’s AI agent runs on Kommo’s own AI credits. Fineguide’s assistants use the credits included in your plan.',
      refs: ['amocrm:ai-agent', 'kommo:plans', 'fg:fg-pricing'],
    },
    {
      q: 'Can the AI answer phone calls?',
      a: 'Fineguide’s assistants answer live inbound and outbound calls over your own SIP phone system, in 14 languages including Romanian and Russian. Kommo’s AI agent answers incoming messages and, on Pro, voice notes; we found no AI on live calls on the Kommo and amoCRM pages we checked.',
      refs: ['fg:fg-voice-ai', 'kommo:ai-agent', 'kommo:plans', 'amocrm:plans'],
    },
    {
      q: 'How do I move my data from amoCRM or Kommo?',
      a: 'Export from the list view (Kommo offers .xlsx, .csv and .vcf), then import the file into the Fineguide CRM, which accepts CSV, TSV, XLS and XLSX, and review duplicates before anything is merged.',
      refs: ['kommo:export', 'amocrm:export', 'fg:fg-llms'],
    },
  ],
  closing: {
    heading: 'Try Fineguide next to your Kommo or amoCRM',
    body: 'Start on the Free plan, no card needed, and put an assistant to work inside the CRM you already use.',
  },
  extraLinks: [
    { href: '/blog/kommo-integration-guide/', label: 'Guide: connect your AI assistant to Kommo' },
    { href: '/blog/is-kommo-the-same-as-amocrm/', label: 'Is Kommo the same as amoCRM?' },
  ],
};
